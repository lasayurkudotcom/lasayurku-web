---
import ProductCard from './ProductCard.astro';
import type { WooCommerceProduct } from '../lib/woocommerce';

interface Props {
  products?: WooCommerceProduct[];
  /** Set true saat data sedang dimuat (mis. fetch client-side) untuk menampilkan skeleton */
  isLoading?: boolean;
  skeletonCount?: number;
  emptyTitle?: string;
  emptyDescription?: string;
}

const {
  products = [],
  isLoading = false,
  skeletonCount = 8,
  emptyTitle = 'Produk tidak ditemukan',
  emptyDescription = 'Coba ubah kata kunci atau kategori pencarian Anda.',
} = Astro.props;
---

<div class="grid grid-cols-2 gap-2 w-full md:grid-cols-4">
  {
    isLoading &&
      Array.from({ length: skeletonCount }).map(() => (
        <div class="flex flex-col overflow-hidden rounded-2xl border border-brand/10 bg-white" aria-hidden="true">
          <div class="aspect-square w-full animate-pulse bg-brand/10" />
          <div class="flex flex-col gap-2 p-3">
            <div class="h-3 w-3/4 animate-pulse rounded bg-brand/10" />
            <div class="h-3 w-1/2 animate-pulse rounded bg-brand/10" />
            <div class="h-4 w-2/3 animate-pulse rounded bg-brand/10" />
            <div class="mt-1 h-8 w-full animate-pulse rounded-lg bg-brand/10" />
          </div>
        </div>
      ))
  }

  {
    !isLoading && products.length === 0 && (
      <div class="col-span-full flex flex-col items-center justify-center gap-2 py-16 text-center">
        <div class="mb-1 flex h-12 w-12 items-center justify-center rounded-full bg-brand/10 text-brand/40">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16z" />
          </svg>
        </div>
        <p class="text-sm font-medium text-neutral-600">{emptyTitle}</p>
        <p class="text-xs text-neutral-400">{emptyDescription}</p>
      </div>
    )
  }

  {!isLoading && products.map((product) => <ProductCard product={product} />)}
</div>
