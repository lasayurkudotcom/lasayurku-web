---
// Bottom Navigation — hanya tampil di viewport mobile/tablet (sm:hidden).
// Desktop tetap memakai nav horizontal di Header.astro.

const currentPath = Astro.url.pathname;
const currentTab = Astro.url.searchParams.get('tab');

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  if (href === '/kategori') return currentPath === '/kategori' || currentPath === '/c';
  if (href === '/pesanan') {
    return currentPath === '/pesanan' || (currentPath === '/akun' && currentTab === 'pesanan');
  }
  return currentPath === href || currentPath.startsWith(`${href}/`);
}

const items = [
  { href: '/', label: 'Beranda', active: isActive('/'), hasIcon: true },
  { href: '/c/sayuran', label: 'Kategori', active: isActive('/c/sayuran'), hasIcon: true },
  { href: '/promo', label: 'Promo', active: isActive('/promo'), hasIcon: true },
  { href: '/pesanan', label: 'Pesanan', active: isActive('/pesanan'), hasIcon: true },
  { href: '/akun', label: 'Akun', active: isActive('/akun'), hasIcon: true },
];
---

<nav
  class="fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-100 flex justify-around items-center py-2 md:hidden"
  aria-label="Navigasi utama"
>
  <div class="mx-auto flex w-full max-w-lg items-center justify-around px-1">
    {items.map((item) => (
      <a
        href={item.href}
        class={`flex flex-1 flex-col items-center justify-center rounded-full px-2 py-2 text-[11px] font-medium transition-all ${
          item.active ? 'bg-brand/10 text-brand' : 'text-gray-500'
        }`}
        aria-current={item.active ? 'page' : undefined}
      >
        {item.hasIcon && item.href === '/' && (
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={item.active ? 2 : 1.5}>
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955a1.125 1.125 0 011.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75" />
          </svg>
        )}

        {item.hasIcon && item.href === '/c/sayuran' && (
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={item.active ? 2 : 1.5}>
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75a2.25 2.25 0 012.25-2.25h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25h-2.25a2.25 2.25 0 01-2.25-2.25v-2.25z" />
          </svg>
        )}

        {item.hasIcon && item.href === '/promo' && (
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={item.active ? 2 : 1.5}>
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 3.75h-9a2.25 2.25 0 00-2.25 2.25v3.75c0 .621.252 1.218.69 1.63l4.06 3.62a1.125 1.125 0 010 1.69l-4.06 3.62a2.25 2.25 0 00-.69 1.63v3.75a2.25 2.25 0 002.25 2.25h9a2.25 2.25 0 002.25-2.25v-3.75c0-.621-.252-1.218-.69-1.63l-4.06-3.62a1.125 1.125 0 010-1.69l4.06-3.62a2.25 2.25 0 00.69-1.63V6a2.25 2.25 0 00-2.25-2.25z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 9.75l4.5 4.5" />
          </svg>
        )}

        {item.hasIcon && item.href === '/pesanan' && (
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={item.active ? 2 : 1.5}>
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6M9 16h6M5.25 4.5h13.5a1.5 1.5 0 011.5 1.5v12a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5V6a1.5 1.5 0 011.5-1.5z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 4.5V3a1.5 1.5 0 011.5-1.5h6A1.5 1.5 0 0116.5 3v1.5" />
          </svg>
        )}

        {item.hasIcon && item.href === '/akun' && (
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={item.active ? 2 : 1.5}>
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.963 0a9 9 0 10-11.963 0m11.963 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        )}

        <span>{item.label}</span>
      </a>
    ))}
  </div>
</nav>
