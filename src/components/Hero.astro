---
---

<section class="relative overflow-hidden rounded-[2rem] bg-brand px-6 py-10 text-white shadow-2xl shadow-black/20 sm:px-8 sm:py-12 mb-10">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-10 md:grid-cols-[1fr_1.05fr] md:items-center md:gap-12">
      <div class="space-y-6">
        <div class="inline-flex rounded-full border border-white/15 bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-white backdrop-blur-md shadow-sm shadow-black/10">
          Pilihan Segar Hari Ini
        </div>

        <div class="space-y-4">
          <h1 class="text-3xl font-extrabold leading-tight tracking-tight text-white sm:text-4xl md:text-5xl">
            Belanja Sayur Lebih Mudah Dan Hemat
          </h1>
          <p class="max-w-xl text-sm text-white/90 sm:text-base md:text-lg">
            Nikmati sayur dan bahan segar langsung dari petani dengan harga terbaik, pilihan lengkap, dan pengiriman cepat.
          </p>
        </div>

        <div>
          <a
            href="#produk"
            class="whitespace-nowrap inline-flex items-center gap-2 rounded-2xl bg-white text-emerald-800 font-bold px-7 py-3.5 text-sm tracking-wide shadow-lg shadow-black/10 transition-all duration-200 hover:bg-emerald-50 hover:scale-105"
          >
            PILIH SEKARANG
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14" />
              <path d="m13 6 6 6-6 6" />
            </svg>
          </a>

          <span class="mt-2 block text-xs text-emerald-100/80">
            Dapat gratis ongkir dan produk organik setiap hari.
          </span>

          <div class="flex flex-wrap gap-2.5 mt-5">
            <span class="bg-emerald-900/40 border border-emerald-400/30 text-emerald-100 text-xs px-3.5 py-1.5 rounded-full backdrop-blur-sm">
              Gratis Ongkir
            </span>
            <span class="bg-emerald-900/40 border border-emerald-400/30 text-emerald-100 text-xs px-3.5 py-1.5 rounded-full backdrop-blur-sm">
              100% Organik
            </span>
            <span class="bg-emerald-900/40 border border-emerald-400/30 text-emerald-100 text-xs px-3.5 py-1.5 rounded-full backdrop-blur-sm">
              Pengiriman 1 Jam
            </span>
          </div>
        </div>
      </div>

      <div class="hidden md:flex justify-center lg:justify-end">
        <div class="w-full max-w-lg overflow-hidden rounded-3xl">
          <img
            src="/hero-banner.webp"
            alt="Ilustrasi sayuran segar"
            class="w-full h-auto object-contain drop-shadow-2xl transition-transform duration-500 hover:scale-[1.02]"
          />
        </div>
      </div>
    </div>
  </div>
</section>
