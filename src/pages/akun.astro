---
import Layout from "../layouts/Layout.astro";

const menuItems = [
  { href: "/pesanan", label: "Pesanan Saya" },
  { href: "/profil", label: "Alamat & Profil Saya" },
  { href: "/garansi-pengembalian", label: "Garansi & Pengembalian" },
  { href: "/kebijakan-privasi", label: "Kebijakan Privasi" },
];
---

<Layout title="Akun Saya — LaSayurku">
  <main class="px-4 pb-16 pt-8">
    <div class="mb-6 flex flex-col items-center gap-2 text-center">
      <div
        class="flex h-16 w-16 items-center justify-center rounded-full bg-brand/10 text-brand"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-8 w-8"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.963 0a9 9 0 10-11.963 0m11.963 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z"
          ></path>
        </svg>
      </div>
      <p id="user-greeting" class="text-sm font-medium text-neutral-600">
        Anda belum masuk
      </p>
      <a
        id="login-btn"
        href="/login"
        class="inline-flex items-center justify-center px-6 py-2.5 bg-brand text-white font-semibold rounded-full hover:bg-brand-dark transition-colors shadow-sm"
      >
        Masuk / Daftar
      </a>
      <button
        id="logout-btn"
        class="hidden mt-2 text-sm text-red-500 font-medium hover:underline"
      >
        Keluar Akun
      </button>
    </div>

    <div
      class="overflow-hidden rounded-2xl border border-slate-100 bg-white divide-y divide-slate-100"
    >
      {
        menuItems.map((item) => (
          <a
            href={item.href}
            class="flex items-center justify-between p-4 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors"
          >
            <span>{item.label}</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 text-brand"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8.25 4.5l7.5 7.5-7.5 7.5"
              />
            </svg>
          </a>
        ))
      }
      <details class="group border-t border-slate-100">
        <summary
          class="flex cursor-pointer items-center justify-between p-4 hover:bg-slate-50 select-none"
        >
          <div class="text-left">
            <span class="block text-sm font-medium text-slate-700"
              >Hubungi Kami & Bantuan</span
            >
            <span
              class="block text-[11px] text-slate-400 font-normal leading-tight mt-0.5"
              >WhatsApp, Telepon, & Email CS</span
            >
          </div>
          <span
            class="transition-transform duration-200 ease-out group-open:rotate-180"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 text-brand"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
            </svg>
          </span>
        </summary>
        <div
          class="border-t border-slate-100 bg-slate-50/50 flex flex-col divide-y divide-slate-100"
        >
          <a
            href="https://wa.me/6288802192324?text=Halo%20LaSayurku,%20saya%20butuh%20bantuan%20mengenai%20pesanan"
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 flex items-center justify-between hover:bg-green-50/50 transition-colors"
          >
            <div class="flex items-center gap-3">
              <svg
                class="h-5 w-5 fill-[#25D366] flex-shrink-0"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
