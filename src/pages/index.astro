---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ProductCard from "../components/ProductCard.astro";
import CategoryExplorer from "../components/CategoryExplorer.tsx";
import { decodeHtml } from "../lib/html";
import {
  getCategories,
  getProducts,
  WooCommerceApiError,
} from "../lib/woocommerce";
import type {
  WooCommerceCategory,
  WooCommerceProduct,
} from "../lib/woocommerce";

// SSR agar data produk & stok selalu up-to-date.
export const prerender = false;

let categories: WooCommerceCategory[] = [];
let featured: WooCommerceProduct[] = [];
let recommended: WooCommerceProduct[] = [];
let allProducts: WooCommerceProduct[] = [];
let totalProducts = 0;
let errorMessage: string | null = null;

try {
  const [categoriesResult, featuredResult, recommendedResult, allResult] =
    await Promise.all([
      getCategories(),
      getProducts({ per_page: 8, orderby: "date", order: "desc" }),
      getProducts({ per_page: 12, orderby: "popularity", order: "desc" }),
      getProducts({ per_page: 24, orderby: "date", order: "desc" }),
    ]);

  categories = categoriesResult.filter((c) => c.parent === 0);
  categories = categories.map((c) => ({ ...c, name: decodeHtml(c.name) }));

  featured = featuredResult.products;
  recommended = recommendedResult.products;
  allProducts = allResult.products;
  totalProducts = allResult.totalProducts;
} catch (err) {
  errorMessage =
    err instanceof WooCommerceApiError
      ? err.message
      : "Terjadi kesalahan tak terduga saat memuat data toko.";
  console.error("[index.astro] Gagal memuat data WooCommerce:", err);
}
---

<Layout>
  <main class="pb-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Hero Banner -->
      <Hero />

      <!-- Mini Promo Cards -->
      <section class="mb-10 grid grid-cols-2 gap-3 md:gap-4">
        <a
          href="/promo"
          class="flex items-center gap-3 rounded-xl border border-orange-200 bg-orange-50 p-3 md:p-4 shadow-sm transition-all duration-200 hover:shadow-md"
        >
          <div
            class="flex h-8 w-8 md:h-10 md:w-10 items-center justify-center rounded-2xl bg-orange-100 text-orange-900 shadow-inner"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              class="h-5 w-5 md:h-6 md:w-6"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <div>
            <p
              class="text-[10px] md:text-xs font-bold uppercase tracking-wider text-orange-700"
            >
              Flash Sale
            </p>
            <p
              class="mt-1 text-xs md:text-sm font-bold text-orange-900 line-clamp-1"
            >
              Diskon s/d 50%
            </p>
          </div>
        </a>

        <a
          href="/promo"
          class="flex items-center gap-3 rounded-xl border border-brand/20 bg-brand/10 p-3 md:p-4 shadow-sm transition-all duration-200 hover:shadow-md"
        >
          <div
            class="flex h-8 w-8 md:h-10 md:w-10 items-center justify-center rounded-2xl bg-brand/20 text-brand shadow-inner"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              class="h-5 w-5 md:h-6 md:w-6"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 7h18M5 7v14h2V7M17 7v14h2V7M9 7v14h2V7M13 7v14h2V7"
              ></path>
            </svg>
          </div>
          <div>
            <p
              class="text-[10px] md:text-xs font-bold uppercase tracking-wider text-brand"
            >
              Gratis Ongkir
            </p>
            <p
              class="mt-1 text-xs md:text-sm font-bold text-brand line-clamp-1"
            >
              Pengiriman cepat tanpa biaya
            </p>
          </div>
        </a>
      </section>

      <!-- Kategori: scroll icon lingkaran + modal "Lihat Semua" -->
      {
        categories.length > 0 && (
          <section class="mt-8">
            <CategoryExplorer
              client:load
              categories={categories.map((c) => ({
                id: c.id,
                name: c.name,
                slug: c.slug,
                image: c.image?.src ?? null,
              }))}
            />
          </section>
        )
      }

      <!-- Pesan error jika API gagal -->
      {
        errorMessage && (
          <div class="mt-8 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            <p class="font-semibold">Gagal memuat produk</p>
            <p class="mt-1 text-red-600">{errorMessage}</p>
          </div>
        )
      }

      <!-- Produk Unggulan Hari Ini -->
      <section id="produk" class="mt-8">
        <div class="mb-4 border-l-4 border-brand pl-3">
          <h2 class="text-xl font-bold text-neutral-900 md:text-2xl">
            Produk Unggulan Hari Ini
          </h2>
          <p class="mt-1 text-sm text-neutral-500">
            Pilihan terbaik untuk kebutuhan segar Anda.
          </p>
        </div>

        <div
          class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4"
        >
          {
            featured.slice(0, 5).map((product, index) => (
              <div class={index === 4 ? "hidden lg:block" : ""}>
                <ProductCard product={product} />
              </div>
            ))
          }
        </div>
      </section>

      <!-- Rekomendasi Minggu Ini -->
      <section class="mt-12">
        <div class="mb-4 border-l-4 border-brand pl-3">
          <h2 class="text-xl font-bold text-neutral-900 md:text-2xl">
            Rekomendasi Minggu Ini
          </h2>
          <p class="mt-1 text-sm text-neutral-500">
            Kumpulan produk yang banyak dicari pembeli minggu ini.
          </p>
        </div>

        <div
          class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4"
        >
          {
            recommended.slice(0, 10).map((product, index) => (
              <div
                class={
                  index >= 8
                    ? "hidden lg:block"
                    : index >= 6
                      ? "hidden md:block"
                      : ""
                }
              >
                <ProductCard product={product} />
              </div>
            ))
          }
        </div>
      </section>

      <!-- Semua Produk -->
      <section class="mt-12">
        <div
          class="mb-4 flex flex-col gap-4 border-l-4 border-brand pl-3 md:flex-row md:items-center md:justify-between"
        >
          <div>
            <h2 class="text-xl font-bold text-neutral-900 md:text-2xl">
              Semua Produk
            </h2>
            <p class="mt-1 text-sm text-neutral-500">
              Telusuri seluruh katalog sayuran dan bahan segar kami.
            </p>
          </div>
          <p class="text-sm text-neutral-500">
            Menampilkan {allProducts.length} dari {totalProducts} produk
          </p>
        </div>

        <div
          id="all-products-grid"
          class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4"
        >
          {
            allProducts.map((product, index) => (
              <div class="product-item transition-all duration-300 overflow-hidden max-h-[1000px] opacity-100 scale-100">
                <ProductCard product={product} />
              </div>
            ))
          }
        </div>

        <div class="mt-6 flex justify-center">
          <button
            id="loadMoreButton"
            type="button"
            class="bg-emerald-50 hover:bg-[#16803d] text-[#16803d] hover:text-white font-bold py-2.5 px-6 rounded-2xl border border-emerald-200 transition-all duration-300 shadow-sm hover:shadow-md text-sm text-center inline-flex items-center justify-center gap-2"
          >
            <span>Muat Lebih Banyak</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
        </div>

        <script>
          // Client-side show/hide for "Semua Produk" grid
          (function () {
            const grid = document.getElementById("all-products-grid");
            if (!grid) return;

            const items = Array.from(grid.querySelectorAll(".product-item"));
            const btn = document.getElementById("loadMoreButton");
            if (!btn) return;

            const DESKTOP_DEFAULT = 20; // 5 columns x 4 rows
            const MOBILE_DEFAULT = 8; // 2 columns x 4 rows
            const INCREMENT = 10; // how many to reveal per click

            function getInitialVisible() {
              return window.innerWidth >= 1024
                ? Math.min(DESKTOP_DEFAULT, items.length)
                : Math.min(MOBILE_DEFAULT, items.length);
            }

            let visibleCount = getInitialVisible();

            function applyVisibility() {
              items.forEach((el, i) => {
                if (i < visibleCount) {
                  el.classList.remove(
                    "max-h-0",
                    "opacity-0",
                    "scale-95",
                    "pointer-events-none",
                  );
                  el.classList.add(
                    "max-h-[1000px]",
                    "opacity-100",
                    "scale-100",
                  );
                } else {
                  el.classList.add(
                    "max-h-0",
                    "opacity-0",
                    "scale-95",
                    "pointer-events-none",
                  );
                  el.classList.remove(
                    "max-h-[1000px]",
                    "opacity-100",
                    "scale-100",
                  );
                }
              });

              if (visibleCount >= items.length) {
                btn.style.display = "none";
              } else {
                btn.style.display = "inline-flex";
              }
            }

            // Initial apply
            applyVisibility();

            // Load more handler
            btn.addEventListener("click", () => {
              visibleCount = Math.min(items.length, visibleCount + INCREMENT);
              applyVisibility();
              // smooth scroll to newly revealed area (optional, gentle)
              const firstNew = items[visibleCount - INCREMENT];
              if (firstNew)
                firstNew.scrollIntoView({
                  behavior: "smooth",
                  block: "nearest",
                });
            });

            // Update visibleCount on resize (optional: keep the already expanded count)
            let resizeTimeout;
            window.addEventListener("resize", () => {
              clearTimeout(resizeTimeout);
              resizeTimeout = setTimeout(() => {
                const initial = getInitialVisible();
                // Only adjust if user hasn't already expanded beyond default
                if (visibleCount < initial) {
                  visibleCount = initial;
                  applyVisibility();
                }
              }, 150);
            });
          })();
        </script>
      </section>
    </div>
  </main>
</Layout>
