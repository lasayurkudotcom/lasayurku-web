---
import Layout from '../layouts/Layout.astro';

// Nomor WA ditaruh di .env sebagai PUBLIC_WHATSAPP_NUMBER (format internasional
// tanpa "+", mis. 6288802192324) supaya mudah diganti tanpa ubah kode.
// Fallback di bawah dipakai kalau env belum diisi saat development.
const waNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '6288802192324';
const waMessage = encodeURIComponent('Halo Admin LaSayurku, saya ingin bertanya tentang pesanan saya.');
const waLink = `https://wa.me/${waNumber}?text=${waMessage}`;

const email = 'cs@lasayurku.com';

const operatingHours = [
  { day: 'Setiap hari (Senin–Minggu)', hours: '06.00 – 21.00 WIB' },
];

const address = 'Jln. Letnan Adun, Kec. Rancaekek, Kab. Bandung, Jawa Barat 40394';
const mapsUrl =
  'https://maps.google.com/maps?q=Jln%20Letnan%20Adun%20Kec.%20Rancaekek%20Kab.%20Bandung%2C%20Jawa%20Barat%2040394&t=m&z=15';
---

<Layout
  title="Hubungi Kami — LaSayurku"
  description="Hubungi Customer Service LaSayurku via WhatsApp, lihat jam operasional pengiriman, dan alamat gudang kami."
>
  <main class="px-4 pb-16 pt-8">
    <div class="mb-6 text-center">
      <h1 class="text-xl font-bold text-neutral-800 sm:text-2xl">Hubungi Kami</h1>
      <p class="mt-1 text-sm text-neutral-500">Ada pertanyaan soal pesanan atau produk? Tim kami siap membantu.</p>
    </div>

    <!-- Kartu CTA WhatsApp -->
    <a
      href={waLink}
      target="_blank"
      rel="noopener noreferrer"
      class="mb-4 flex items-center gap-4 rounded-2xl bg-brand px-5 py-4 text-white shadow-sm transition-transform hover:-translate-y-0.5"
    >
      <span class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-white/15">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor">
          <path d="M12.01 2C6.48 2 2 6.48 2 12.01c0 1.99.58 3.85 1.58 5.42L2 22l4.7-1.55A9.96 9.96 0 0012.01 22C17.54 22 22 17.52 22 11.99 22 6.47 17.54 2 12.01 2zm5.78 14.13c-.24.68-1.4 1.3-1.93 1.36-.5.06-1.03.29-3.46-.72-2.91-1.2-4.78-4.17-4.93-4.36-.14-.2-1.18-1.57-1.18-3 0-1.42.75-2.12 1.02-2.41.26-.29.57-.36.76-.36.19 0 .38 0 .55.01.18.01.42-.07.65.5.24.58.82 2 .89 2.14.07.14.11.3.02.49-.09.19-.14.3-.28.46-.14.16-.29.36-.42.48-.14.13-.28.28-.12.55.16.27.72 1.19 1.55 1.93 1.06.95 1.96 1.24 2.23 1.38.27.14.43.12.59-.07.16-.19.68-.79.86-1.06.18-.27.36-.22.6-.13.24.09 1.53.72 1.79.85.26.13.43.19.5.3.06.11.06.65-.18 1.33z" />
        </svg>
      </span>
      <span class="flex-1">
        <span class="block text-sm font-semibold">Chat via WhatsApp</span>
        <span class="block text-xs text-white/80">Respon cepat, biasanya balas dalam beberapa menit</span>
      </span>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
    </a>

    <!-- Email -->
    <a
      href={`mailto:${email}`}
      class="mb-6 flex items-center gap-4 rounded-2xl border border-brand/10 bg-white px-5 py-4 shadow-sm hover:bg-brand/10"
    >
      <span class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-brand/10 text-brand">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
        </svg>
      </span>
      <span class="flex-1">
        <span class="block text-sm font-semibold text-neutral-800">Email Customer Service</span>
        <span class="block text-xs text-neutral-500">{email}</span>
      </span>
    </a>

    <!-- Jam operasional -->
    <section class="mb-6 rounded-2xl border border-brand/10 bg-white p-5">
      <div class="mb-3 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <h2 class="text-sm font-bold text-neutral-800">Jam Operasional Pengiriman</h2>
      </div>
      <ul class="flex flex-col gap-1.5">
        {
          operatingHours.map((item) => (
            <li class="flex items-center justify-between text-sm">
              <span class="text-neutral-600">{item.day}</span>
              <span class="font-semibold text-brand">{item.hours}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 text-xs text-neutral-400">
        Pesanan yang masuk di luar jam operasional akan diproses pada jam buka berikutnya.
      </p>
    </section>

    <!-- Alamat gudang -->
    <section class="rounded-2xl border border-brand/10 bg-white p-5">
      <div class="mb-3 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
        </svg>
        <h2 class="text-sm font-bold text-neutral-800">Alamat Gudang / Hub Operasional</h2>
      </div>
      <p class="text-sm text-neutral-600">{address}</p>
      <a
        href={mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-brand hover:underline"
      >
        Buka di Google Maps
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L6.75 17.25M17.25 6.75H9m8.25 0v8.25" />
        </svg>
      </a>
    </section>
  </main>
</Layout>
