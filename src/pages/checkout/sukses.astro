---
import Layout from "../../layouts/Layout.astro";
import {
  getOrderById,
  formatRupiah,
  WooCommerceApiError,
} from "../../lib/woocommerce";
import { generateDynamicQris } from "../../lib/qris";
import type { WooCommerceOrder } from "../../lib/woocommerce";

export const prerender = false;

const orderIdParam = Astro.url.searchParams.get("order");
let order: WooCommerceOrder | null = null;
let errorMessage: string | null = null;
let qrisPayload = "";
let qrisImageUrl = "";
let qrisAmount = 0;

if (orderIdParam) {
  try {
    order = await getOrderById(Number(orderIdParam));

    if (order && order.payment_method === "qris") {
      qrisAmount = Number(order.total) || 0;
      if (qrisAmount > 0) {
        try {
          qrisPayload = generateDynamicQris(qrisAmount);
          qrisImageUrl = `https://api.qrserver.com/v1/create-qr-code/?size=400x400&ecc=M&margin=2&data=${encodeURIComponent(qrisPayload)}`;
        } catch (e) {
          console.error("Gagal buat QRIS:", e);
        }
      }
    }
  } catch (err) {
    errorMessage =
      err instanceof WooCommerceApiError
        ? err.message
        : "Gagal memuat detail pesanan.";
    console.error("[checkout/sukses.astro] Gagal memuat pesanan:", err);
  }
}
---

<Layout title="Pesanan Berhasil — LaSayurku">
  <main class="mx-auto max-w-2xl px-4 pb-16 pt-10 text-center">
    <div
      class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-brand/10 text-brand"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-7 w-7"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4.5 12.75l6 6 9-13.5"></path>
      </svg>
    </div>

    <h1 class="text-xl font-bold text-neutral-800">Pesanan Berhasil Dibuat!</h1>

    {
      order ? (
        <div class="mt-6 rounded-xl border border-brand/10 bg-white p-6 text-left">
          <p class="text-sm text-neutral-500">Nomor Pesanan</p>
          <p class="text-lg font-bold text-black">#{order.id}</p>

          <ul class="mt-4 flex flex-col gap-2 border-t border-gray-200 pt-4">
            {order.line_items.map((item) => (
              <li class="flex justify-between text-sm text-neutral-600">
                <span>
                  {item.name}{" "}
                  <span class="text-neutral-400">x{item.quantity}</span>
                </span>
                <span class="font-medium text-neutral-800">
                  {formatRupiah(item.total)}
                </span>
              </li>
            ))}
          </ul>

          <div class="mt-4 flex justify-between border-t border-gray-200 pt-4 text-sm font-bold">
            <span>Total</span>
            <span class="text-brand">{formatRupiah(order.total)}</span>
          </div>

          {order.payment_method === "qris" ? (
            <div class="mt-4 text-left rounded-3xl border border-slate-200 bg-slate-50 p-4 sm:p-6">
              <h2 class="text-lg font-bold text-neutral-800">
                Pembayaran QRIS
              </h2>
              <div class="mx-auto my-4 max-w-sm overflow-hidden rounded-3xl border border-slate-200 bg-white p-4 shadow-sm sm:max-w-md text-center">
                {qrisImageUrl ? (
                  <img
                    src={qrisImageUrl}
                    alt="QRIS LA.Sayurku"
                    class="mx-auto h-64 w-64 object-contain"
                  />
                ) : (
                  <div class="mx-auto flex h-64 w-64 items-center justify-center rounded-3xl bg-slate-100 text-sm text-slate-500">
                    QRIS tidak tersedia
                  </div>
                )}
                <div class="mt-4 space-y-2 text-sm text-neutral-700 text-left">
                  <p class="font-semibold text-neutral-900">
                    Scan QRIS di atas menggunakan BCA, Mandiri, Gopay, OVO,
                    ShopeePay, atau Dana.
                  </p>
                  <p class="text-slate-600">
                    Masukkan nominal persis:{" "}
                    <span class="font-bold text-brand text-base">
                      {formatRupiah(qrisAmount)}
                    </span>
                  </p>
                </div>
              </div>
            </div>
          ) : order.payment_method === "bacs" ||
            order.payment_method === "transfer" ? (
            <div class="mt-4 text-left rounded-3xl border border-slate-200 bg-slate-50 p-4 sm:p-6">
              <h2 class="text-lg font-bold text-neutral-800">
                Silakan Lakukan Pembayaran
              </h2>
              <div class="mx-auto my-4 max-w-sm overflow-hidden rounded-3xl border border-slate-200 bg-white p-4 shadow-sm sm:max-w-md">
                <img
                  src="/payments/mandiri.webp"
                  alt="Logo Bank Mandiri"
                  class="mx-auto h-20 w-auto"
                />
                <div class="mt-4 space-y-2 text-sm text-neutral-700 text-left">
                  <p class="font-semibold text-neutral-900">Bank Mandiri</p>
                  <p>
                    No. Rekening:{" "}
                    <span id="mandiri-account-number" class="font-semibold">
                      1320026164807
                    </span>
                  </p>
                  <p>
                    Atas Nama: <span class="font-semibold">RISMAN IRAWAN</span>
                  </p>
                  <p class="text-sm text-neutral-500">
                    Transfer sesuai total tagihan:{" "}
                    <span class="font-semibold text-brand">
                      {formatRupiah(order.total)}
                    </span>
                  </p>
                </div>
              </div>
              <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <button
                  id="copy-account-button"
                  type="button"
                  class="inline-flex items-center justify-center rounded-full bg-brand px-5 py-3 text-sm font-semibold text-white transition hover:bg-brand-dark focus:outline-none focus:ring-2 focus:ring-brand/40"
                >
                  Salin No. Rekening
                </button>
                <p class="text-sm text-slate-500">
                  Gunakan nomor rekening di atas untuk melakukan transfer
                  manual.
                </p>
              </div>
            </div>
          ) : order.payment_method === "cod" ? (
            <div class="mt-4 text-left">
              <p class="text-sm text-neutral-600">
                Bayar di Tempat (COD). Siapkan uang pas saat pesanan diantar
                oleh kurir.
              </p>
            </div>
          ) : null}

          <a
            href={`https://wa.me/6288802192324?text=Halo%20Admin,%20saya%20sudah%20transfer%20untuk%20pesanan%20%23${order.id}`}
            target="_blank"
            class="w-full mt-6 bg-brand text-white font-bold py-3 px-6 rounded-full hover:bg-brand-dark flex items-center justify-center gap-2 mb-3"
          >
            Konfirmasi Pembayaran via WA
          </a>
        </div>
      ) : (
        <p class="mt-4 text-sm text-neutral-500">
          {errorMessage ??
            "Terima kasih telah berbelanja. Kami akan segera menghubungi Anda untuk konfirmasi pesanan."}
        </p>
      )
    }

    <a
      href="/"
      class="mt-8 inline-block rounded-full bg-brand px-6 py-2.5 text-sm font-semibold text-white hover:bg-brand-dark"
    >
      Kembali Belanja
    </a>
  </main>

  <script type="module">
    const copyButton = document.getElementById("copy-account-button");
    const accountNumber = document.getElementById("mandiri-account-number");

    if (copyButton && accountNumber) {
      copyButton.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(
            accountNumber.textContent?.trim() ?? "",
          );
          const toast = document.createElement("div");
          toast.textContent = "No. rekening berhasil disalin";
          toast.className =
            "fixed bottom-6 left-1/2 z-50 w-[calc(100%-2rem)] max-w-sm -translate-x-1/2 rounded-full bg-slate-900 px-4 py-3 text-sm text-white shadow-lg shadow-slate-900/30 sm:w-auto";
          document.body.appendChild(toast);
          setTimeout(() => toast.remove(), 2400);
        } catch (err) {
          const toast = document.createElement("div");
          toast.textContent = "Gagal menyalin nomor rekening";
          toast.className =
            "fixed bottom-6 left-1/2 z-50 w-[calc(100%-2rem)] max-w-sm -translate-x-1/2 rounded-full bg-rose-500 px-4 py-3 text-sm text-white shadow-lg shadow-slate-900/30 sm:w-auto";
          document.body.appendChild(toast);
          setTimeout(() => toast.remove(), 2400);
        }
      });
    }
  </script>
</Layout>
