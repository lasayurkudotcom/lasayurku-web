---
import Layout from "../layouts/Layout.astro";

export const prerender = false;
---

<Layout title="Alamat & Profil Saya — LaSayurku">
  <main class="mx-auto max-w-md px-4 py-8">
    <div class="mb-6 flex items-center gap-3">
      <a
        href="/akun"
        class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15.75 19.5L8.25 12l7.5-7.5"></path>
        </svg>
      </a>
      <h1 class="text-xl font-bold text-neutral-800">Alamat & Profil Saya</h1>
    </div>

    <!-- Loading State -->
    <div
      id="profile-loading"
      class="flex flex-col items-center justify-center py-20 text-brand"
    >
      <svg class="w-10 h-10 animate-spin mb-4" fill="none" viewBox="0 0 24 24">
        <circle
          class="opacity-25"
          cx="12"
          cy="12"
          r="10"
          stroke="currentColor"
          stroke-width="4"></circle>
        <path
          class="opacity-75"
          fill="currentColor"
          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
        ></path>
      </svg>
      <p class="font-medium text-neutral-500">Memuat profil Anda...</p>
    </div>

    <!-- Error State -->
    <div
      id="profile-error"
      class="hidden rounded-xl bg-red-50 border border-red-200 p-4 text-center text-sm text-red-600 mb-6"
    >
    </div>

    <!-- Success State -->
    <div
      id="profile-success"
      class="hidden rounded-xl bg-green-50 border border-green-200 p-4 text-center text-sm text-green-600 mb-6 font-semibold"
    >
      Profil berhasil disimpan!
    </div>

    <!-- Form Section -->
    <form id="profile-form" class="hidden flex-col gap-4">
      <div>
        <label class="block text-sm font-semibold text-neutral-700 mb-1"
          >Nama Depan <span class="text-red-500">*</span></label
        >
        <input
          type="text"
          id="first-name"
          required
          class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"
        />
      </div>

      <div>
        <label class="block text-sm font-semibold text-neutral-700 mb-1"
          >Nama Belakang <span class="text-red-500">*</span></label
        >
        <input
          type="text"
          id="last-name"
          required
          class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"
        />
      </div>

      {/* Email disembunyikan untuk menyederhanakan profil */}

      <div>
        <label class="block text-sm font-semibold text-neutral-700 mb-1"
          >Nomor WhatsApp <span class="text-red-500">*</span></label
        >
        <input
          type="tel"
          id="phone"
          required
          class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"
        />
      </div>

      <div>
        <label class="block text-sm font-semibold text-neutral-700 mb-1"
          >Alamat Lengkap <span class="text-red-500">*</span></label
        >
        <textarea
          id="address"
          required
          rows={3}
          class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"
        ></textarea>
      </div>

      <div>
        <label class="block text-sm font-semibold text-neutral-700 mb-1"
          >Kota / Kecamatan <span class="text-red-500">*</span></label
        >
        <input
          type="text"
          id="city"
          required
          class="w-full rounded-xl border border-slate-200 px-4 py-2.5 text-sm focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand"
        />
      </div>

      <button
        type="submit"
        id="save-btn"
        class="mt-4 w-full rounded-full bg-brand py-3 text-sm font-semibold text-white hover:bg-brand-dark transition-colors shadow-sm disabled:opacity-50"
      >
        Simpan Alamat & Profil
      </button>
    </form>
  </main>
</Layout>

<script>
  function initProfilePage() {
    // 1. Ambil token dari beberapa kemungkinan key yang tersimpan di localStorage
    const token =
      localStorage.getItem("user_token") || localStorage.getItem("auth_token");
    const customerId =
      localStorage.getItem("user_id") || localStorage.getItem("user_email");

    // Jika tidak ada token sama sekali, lempar ke halaman login
    if (!token) {
      window.location.href = "/login";
      return;
    }

    const loadingEl = document.getElementById("profile-loading");
    const errorEl = document.getElementById("profile-error");
    const successEl = document.getElementById("profile-success");
    const formEl = document.getElementById("profile-form") as HTMLFormElement;
    const saveBtn = document.getElementById("save-btn") as HTMLButtonElement;

    // Form inputs
    const firstNameInput = document.getElementById(
      "first-name",
    ) as HTMLInputElement;
    const lastNameInput = document.getElementById(
      "last-name",
    ) as HTMLInputElement;
    const emailInput = document.getElementById("email") as HTMLInputElement;
    const phoneInput = document.getElementById("phone") as HTMLInputElement;
    const addressInput = document.getElementById(
      "address",
    ) as HTMLTextAreaElement;
    const cityInput = document.getElementById("city") as HTMLInputElement;

    // Isikan email lokal terlebih dahulu sebagai fallback jika API lambat
    if (emailInput) {
      emailInput.value = localStorage.getItem("user_email") || "";
    }

    // 2. Fetch data profil pengguna
    const fetchUrl = customerId
      ? `/api/wc-update-user?customerId=${encodeURIComponent(customerId)}`
      : `/api/wc-update-user`;

    fetch(fetchUrl, {
      headers: {
        Authorization: `Bearer ${token}`,
      },
    })
      .then((res) => {
        if (!res.ok)
          throw new Error("Gagal mengambil data profil dari server.");
        return res.json();
      })
      .then((data) => {
        if (loadingEl) loadingEl.classList.add("hidden");
        if (formEl) {
          formEl.classList.remove("hidden");
          formEl.style.display = "flex";
        }

        // Isi form dari response API
        if (firstNameInput)
          firstNameInput.value =
            data.first_name || data.billing?.first_name || "";
        if (lastNameInput)
          lastNameInput.value = data.last_name || data.billing?.last_name || "";
        if (emailInput)
          emailInput.value =
            data.email ||
            data.billing?.email ||
            localStorage.getItem("user_email") ||
            "";
        if (phoneInput) phoneInput.value = data.billing?.phone || "";
        if (addressInput) addressInput.value = data.billing?.address_1 || "";
        if (cityInput) cityInput.value = data.billing?.city || "";
      })
      .catch((err) => {
        if (loadingEl) loadingEl.classList.add("hidden");
        // Jika API gagal tapi pengguna memiliki session token lokal, tetap tampilkan form agar bisa diisi
        if (formEl) {
          formEl.classList.remove("hidden");
          formEl.style.display = "flex";
        }
        if (errorEl) {
          errorEl.textContent =
            err.message || "Terjadi kesalahan saat memuat data.";
          errorEl.classList.remove("hidden");
        }
      });

    // 3. Handle submit form untuk menyimpan perubahan
    if (formEl) {
      formEl.onsubmit = async (e) => {
        e.preventDefault();

        if (saveBtn) {
          saveBtn.disabled = true;
          saveBtn.textContent = "Menyimpan...";
        }
        if (errorEl) errorEl.classList.add("hidden");
        if (successEl) successEl.classList.add("hidden");

        const first_name = firstNameInput ? firstNameInput.value.trim() : "";
        const last_name = lastNameInput ? lastNameInput.value.trim() : "";
        const phone = phoneInput ? phoneInput.value.trim() : "";
        const address_1 = addressInput ? addressInput.value.trim() : "";
        const city = cityInput ? cityInput.value.trim() : "";

        try {
          const res = await fetch("/api/wc-update-user", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Authorization: `Bearer ${token}`,
            },
            body: JSON.stringify({
              customerId,
              first_name,
              last_name,
              billing: {
                first_name,
                last_name,
                phone,
                address_1,
                city,
              },
              shipping: {
                first_name,
                last_name,
                phone,
                address_1,
                city,
              },
            }),
          });

          const result = await res.json();

          if (!res.ok) {
            throw new Error(result.message || "Gagal menyimpan perubahan.");
          }

          // Sinkronisasi nama baru ke localStorage
          const fullName = `${first_name} ${last_name}`.trim();
          if (fullName) {
            localStorage.setItem("user_nicename", fullName);
          }

          if (successEl) {
            successEl.classList.remove("hidden");
            setTimeout(() => {
              successEl.classList.add("hidden");
            }, 3000);
          }
        } catch (err: any) {
          if (errorEl) {
            errorEl.textContent = err.message || "Gagal memperbarui profil.";
            errorEl.classList.remove("hidden");
          }
        } finally {
          if (saveBtn) {
            saveBtn.disabled = false;
            saveBtn.textContent = "Simpan Alamat & Profil";
          }
        }
      };
    }
  }

  // Jalankan langsung & pasca-navigasi Astro ViewTransitions
  initProfilePage();
  document.addEventListener("DOMContentLoaded", initProfilePage);
  document.addEventListener("astro:page-load", initProfilePage);
</script>
