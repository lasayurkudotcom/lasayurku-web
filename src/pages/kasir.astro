---
export const prerender = false;
import POSApp from '@components/pos/POSApp';
const title = 'Kasir LaSayurku';
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <style>
      :root {
        --bg: #f1f5f9;
        --card: #ffffff;
        --border: #cbd5e1;
        --fg: #0f172a;
        --muted: #64748b;
        --accent: #0f9f6e;
        --accent-strong: #0a7d56;
        --accent-soft: rgba(15, 159, 110, 0.12);
        --danger: #e11d48;
        --danger-soft: rgba(225, 29, 72, 0.1);
        --warn: #d97706;
        --shadow: 0 10px 25px rgba(15, 23, 42, 0.06);
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'DM Sans', sans-serif;
        background: var(--bg);
        color: var(--fg);
        min-height: 100vh;
      }
      h1, h2, h3, h4, h5 { font-family: 'Space Grotesk', sans-serif; }
      button, input { font: inherit; }

      .sidebar {
        position: fixed; left: 0; top: 0; bottom: 0; width: 84px; background: #ffffff;
        border-right: 1.5px solid var(--border);
        display: flex; flex-direction: column; align-items: center; padding: 20px 0 18px; z-index: 50;
      }
      .logo {
        width: 46px; height: 46px; background: linear-gradient(135deg, #10b981, #0a7d56);
        border-radius: 15px; display: flex; align-items: center; justify-content: center; font-weight: 800; color: white;
        margin-bottom: 26px; box-shadow: 0 10px 20px rgba(15,159,110,0.3);
      }
      .nav-group { display: flex; flex-direction: column; align-items: center; gap: 8px; width: 100%; }
      .nav-item {
        width: 52px; height: 52px; border-radius: 16px; display: flex; align-items: center; justify-content: center;
        color: var(--muted); cursor: pointer; transition: all 0.2s ease; font-size: 18px;
        border: 1px solid transparent; background: transparent;
      }
      .nav-item.active {
        background: var(--accent-soft); color: var(--accent); border-color: rgba(15, 159, 110, 0.2);
      }
      .nav-item.nav-cod.active { background: rgba(245,158,11,0.12); color: #b45309; }
      .nav-spacer { flex: 1; }

      .main { margin-left: 84px; padding: 26px 28px 32px; min-height: 100vh; }
      .page { display: none; }
      .page.active { display: block; }

      .input {
        background: #ffffff !important; border: 1.5px solid var(--border) !important; border-radius: 14px; padding: 12px 16px; color: var(--fg); font-size: 14px; width: 100%; outline: none;
      }
      .btn {
        border: none; border-radius: 12px; font-weight: 700; cursor: pointer; transition: all 0.2s ease;
        display: inline-flex; align-items: center; justify-content: center; gap: 6px;
      }
      .btn:hover { transform: translateY(-1px); }
      .btn-primary {
        background: linear-gradient(135deg, var(--accent), var(--accent-strong));
        color: white; box-shadow: 0 8px 18px rgba(15, 159, 110, 0.25);
      }
      .btn-danger { background: var(--danger-soft); color: var(--danger); border: 1px solid rgba(225,29,72,0.2); }

      .toast-container { position: fixed; top: 24px; right: 24px; z-index: 200; display: flex; flex-direction: column; gap: 10px; }
      .toast { background: rgba(255,255,255,0.95); border: 1px solid var(--border); border-radius: 14px; padding: 12px 16px; display: flex; align-items: center; gap: 10px; font-size: 14px; box-shadow: var(--shadow); }
      .modal-overlay { position: fixed; inset: 0; background: rgba(15,23,42,0.4); backdrop-filter: blur(4px); z-index: 100; display: none; align-items: center; justify-content: center; }
      .modal-overlay.show { display: flex; }
      .modal { background: #ffffff; border: 1.5px solid #cbd5e1; border-radius: 24px; padding: 28px; width: min(92vw, 480px); box-shadow: 0 20px 50px rgba(0,0,0,0.15); }

      .page-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 20px; }
      .page-header h1 { font-size: clamp(1.7rem, 2vw, 2.3rem); font-weight: 800; margin: 0; }
      .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px; margin-bottom: 24px; }
      .stat-card { background: #ffffff !important; border: 1.5px solid #cbd5e1 !important; border-radius: 20px; padding: 20px; box-shadow: var(--shadow); }
      .stat-label { font-size: 11px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 700; }
      .stat-value { font-size: clamp(1.5rem, 2vw, 2.2rem); font-weight: 800; margin-top: 6px; }
      .muted { color: var(--muted); }

      .stok-filter-btn { padding: 8px 16px; border-radius: 10px; font-size: 13px; font-weight: 700; border: 1.5px solid #cbd5e1; background: white; color: var(--muted); cursor: pointer; }
      .stok-filter-btn.active { background: var(--accent-soft); color: var(--accent); border-color: rgba(15,159,110,0.3); }

      @media (max-width: 760px) {
        .sidebar { position: sticky; top: 0; width: 100%; height: auto; border-right: none; border-bottom: 1.5px solid #cbd5e1; padding: 12px 14px; flex-direction: row; justify-content: space-between; }
        .logo { margin: 0; }
        .nav-group { flex-direction: row; gap: 10px; }
        .nav-spacer { display: none; }
        .main { margin-left: 0; padding: 18px 14px 26px; }
      }
    </style>
  </head>
  <body>
    <div class="toast-container" id="toastContainer"></div>

    <!-- SIDEBAR NAVIGATION -->
    <nav class="sidebar" aria-label="Menu utama">
      <div class="logo">K</div>
      <div class="nav-group">
        <div class="nav-item active" data-page="kasir" title="Kasir Offline"><i class="fas fa-cash-register"></i></div>
        <div class="nav-item" data-page="stok" title="Stok"><i class="fas fa-warehouse"></i></div>
        <div class="nav-item" data-page="histori" title="Histori Penjualan"><i class="fas fa-clock-rotate-left"></i></div>
        <div class="nav-item nav-cod" data-page="cod" title="Orderan COD"><i class="fas fa-motorcycle"></i></div>
      </div>
      <div class="nav-spacer"></div>
      <div class="nav-item" id="navLogout" title="Keluar"><i class="fas fa-right-from-bracket" style="color: var(--danger);"></i></div>
    </nav>

    <!-- KONTEN UTAMA -->
    <main class="main">
      <!-- PAGE KASIR (REACT APPS OFFLINE) -->
      <section class="page active" id="pageKasir">
        <div id="kasir-offline-root" class="min-h-screen bg-slate-50 text-slate-900 rounded-2xl overflow-hidden p-2">
          <POSApp client:only="react" />
        </div>
      </section>

      <!-- PAGE STOK -->
      <section class="page" id="pageStok">
        <div class="page-header">
          <div>
            <h1>Manajemen Stok</h1>
            <p class="muted" style="margin-top:6px;">Sinkronisasi otomatis dari server WooCommerce.</p>
          </div>
          <button id="btnRefreshStok" class="btn btn-primary" style="padding:10px 16px;">
            <i class="fas fa-sync-alt" style="margin-right:6px;"></i> Segarkan
          </button>
        </div>

        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-label">Produk Aktif</div>
            <div class="stat-value" id="stokStatTotal">0</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Stok Rendah (&le;5)</div>
            <div class="stat-value" id="stokStatLow" style="color:var(--warn);">0</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Stok Habis</div>
            <div class="stat-value" id="stokStatOut" style="color:var(--danger);">0</div>
          </div>
        </div>

        <div class="card" style="padding:0; overflow:hidden; background:#fff; border:1.5px solid #cbd5e1; border-radius:20px;">
          <div style="padding:16px; border-bottom:1px solid #cbd5e1; display:flex; gap:12px; flex-wrap:wrap; align-items:center; justify-content:space-between;">
            <div style="position:relative; flex:1; min-width:240px;">
              <i class="fas fa-search" style="position:absolute; left:14px; top:50%; transform:translateY(-50%); color:var(--muted);"></i>
              <input type="text" class="input" id="searchStok" placeholder="Cari nama produk..." style="padding-left:40px;" />
            </div>
            <div style="display:flex; gap:8px;">
              <button class="stok-filter-btn active" data-stok-filter="all">Semua</button>
              <button class="stok-filter-btn" data-stok-filter="low">Stok Rendah</button>
              <button class="stok-filter-btn" data-stok-filter="out">Stok Habis</button>
            </div>
          </div>

          <div style="overflow-x:auto;">
            <table style="width:100%; border-collapse:collapse; text-align:left; font-size:14px;">
              <thead>
                <tr style="background:#f8fafc; border-bottom:1px solid #cbd5e1; color:var(--muted); font-size:12px; text-transform:uppercase;">
                  <th style="padding:14px 18px;">Produk</th>
                  <th style="padding:14px 18px;">Harga</th>
                  <th style="padding:14px 18px; text-align:center;">Jumlah Stok</th>
                  <th style="padding:14px 18px; text-align:center;">Status</th>
                  <th style="padding:14px 18px; text-align:center;">Aksi</th>
                </tr>
              </thead>
              <tbody id="stokTableBody">
                <tr>
                  <td colspan="5" style="text-align:center; padding:40px; color:var(--muted);">Memuat inventaris produk...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- PAGE HISTORI PENJUALAN -->
      <section class="page" id="pageHistori">
        <div class="page-header">
          <div>
            <h1>Histori Penjualan</h1>
            <p class="muted" style="margin-top:6px;">Catatan transaksi sukses dari kasir POS dan WooCommerce.</p>
          </div>
          <button id="btnRefreshHistory" class="btn btn-primary" style="padding:10px 16px;">
            <i class="fas fa-sync-alt" style="margin-right:6px;"></i> Segarkan
          </button>
        </div>

        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-label">Total Transaksi Selesai</div>
            <div class="stat-value" id="histStatTotal">0</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Total Pendapatan</div>
            <div class="stat-value" id="histStatOmset" style="color:var(--accent);">Rp 0</div>
          </div>
        </div>

        <div class="card" style="padding:0; overflow:hidden; background:#fff; border:1.5px solid #cbd5e1; border-radius:20px;">
          <div style="padding:16px; border-bottom:1px solid #cbd5e1; display:flex; gap:12px;">
            <div style="position:relative; flex:1;">
              <i class="fas fa-search" style="position:absolute; left:14px; top:50%; transform:translateY(-50%); color:var(--muted);"></i>
              <input type="text" class="input" id="searchHistory" placeholder="Cari No. Order atau Pelanggan..." style="padding-left:40px;" />
            </div>
          </div>

          <div style="overflow-x:auto;">
            <table style="width:100%; border-collapse:collapse; text-align:left; font-size:14px;">
              <thead>
                <tr style="background:#f8fafc; border-bottom:1px solid #cbd5e1; color:var(--muted); font-size:12px; text-transform:uppercase;">
                  <th style="padding:14px 18px;">No. Order</th>
                  <th style="padding:14px 18px;">Tanggal</th>
                  <th style="padding:14px 18px;">Pelanggan</th>
                  <th style="padding:14px 18px;">Metode</th>
                  <th style="padding:14px 18px; text-align:right;">Total</th>
                  <th style="padding:14px 18px; text-align:center;">Aksi</th>
                </tr>
              </thead>
              <tbody id="histTableBody">
                <tr>
                  <td colspan="6" style="text-align:center; padding:40px; color:var(--muted);">Memuat histori transaksi...</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- PAGE COD -->
      <section class="page" id="pageCod">
        <div class="page-header">
          <div>
            <h1>Orderan COD (Pesanan Web)</h1>
            <p class="muted" style="margin-top:6px;">Konfirmasi pesanan pelanggan yang masuk dari website WooCommerce.</p>
          </div>
          <button id="btnRefreshCodOrders" class="btn btn-primary" style="padding:10px 16px;">
            <i class="fas fa-sync-alt" style="margin-right:4px;"></i> Segarkan
          </button>
        </div>

        <div id="codOrdersEmpty" class="card" style="display:block; background:#fff; border:1.5px solid #cbd5e1; border-radius:20px; padding:24px;">
          <p class="muted">Belum ada pesanan web yang menunggu konfirmasi.</p>
        </div>

        <div id="codOrdersGrid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:20px;"></div>
      </section>
    </main>

    <!-- MODAL EDIT STOK -->
    <div class="modal-overlay" id="modalEditStok">
      <div class="modal" style="max-width: 380px;">
        <h3 style="font-size: 20px; font-weight: 800; margin-bottom: 6px;"><i class="fas fa-boxes" style="color:var(--accent); margin-right:8px;"></i>Update Stok</h3>
        <p style="color:var(--muted); font-size: 13px; margin-bottom: 16px;" id="modalStokProductName">Nama Produk</p>
        
        <div style="margin-bottom:20px;">
          <label style="font-size: 12px; font-weight: 700; color: var(--muted); display: block; margin-bottom: 6px; text-transform: uppercase;">Jumlah Stok Baru</label>
          <input type="number" class="input" id="modalStokQtyInput" min="0" style="font-size: 18px; font-weight: 700; text-align: center;" />
        </div>

        <div style="display: flex; gap: 10px;">
          <button class="btn" style="flex: 1; border: 1px solid #cbd5e1; background: white; padding: 12px;" id="btnCancelEditStok">Batal</button>
          <button class="btn btn-primary" style="flex: 1; padding: 12px;" id="btnSaveEditStok">Simpan</button>
        </div>
      </div>
    </div>

    <!-- MODAL DETAIL HISTORI TRANSAKSI -->
    <div class="modal-overlay" id="modalDetailHistori">
      <div class="modal" style="max-width: 520px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid #cbd5e1;">
          <h3 style="font-size:20px; font-weight:800; margin:0;" id="modalHistTitle">Detail Transaksi</h3>
          <span id="modalHistBadge" style="padding:4px 10px; border-radius:999px; font-size:11px; font-weight:800;"></span>
        </div>

        <div id="modalHistContent"></div>

        <div style="margin-top:20px; text-align:right;">
          <button class="btn" style="border:1px solid #cbd5e1; background:white; padding:10px 20px;" id="btnCloseDetailHist">Tutup</button>
        </div>
      </div>
    </div>

    <!-- MODAL KONFIRMASI LOGOUT -->
    <div class="modal-overlay" id="modalConfirmLogout">
      <div class="modal" style="max-width: 380px; text-align: center;">
        <div style="width: 60px; height: 60px; border-radius: 20px; background: rgba(225,29,72,0.1); color: var(--danger); display: flex; align-items: center; justify-content: center; font-size: 26px; margin: 0 auto 16px;">
          <i class="fas fa-right-from-bracket"></i>
        </div>
        <h3 style="font-size: 20px; font-weight: 800; margin-bottom: 8px;">Keluar Kasir</h3>
        <p style="color: var(--muted); font-size: 14px; margin-bottom: 24px;">Apakah Anda yakin ingin keluar dari sistem kasir?</p>
        <div style="display: flex; gap: 10px;">
          <button class="btn" style="flex: 1; border: 1px solid #cbd5e1; background: white; padding: 12px;" id="btnCancelLogout">Batal</button>
          <button class="btn btn-danger" style="flex: 1; padding: 12px; background: var(--danger); color: white;" id="btnExecuteLogout">Ya, Keluar</button>
        </div>
      </div>
    </div>

    <!-- SCRIPT OTENTIKASI ASTRO -->
    <script>
      import { getAdminSession, roleAllowed } from '../lib/adminAuth';

      document.addEventListener('DOMContentLoaded', () => {
        const session = getAdminSession('online') || getAdminSession();
        const allowed = ['kasir', 'administrator', 'admin'];
        if (!session || !roleAllowed(session.role, allowed)) {
          window.location.replace('/login?from=admin&error=denied');
        }
      });
    </script>

    <!-- SCRIPT CLIENT DOM HANDLERS -->
    <script is:inline>
      let products = [];
      let historyOrders = [];
      let selectedStokProduct = null;
      let activeStokFilter = 'all';

      const formatRp = (v) => `Rp ${Math.round(v || 0).toLocaleString('id-ID')}`;

      function showToast(msg, type = 'success') {
        const c = document.getElementById('toastContainer');
        if (!c) return;
        const t = document.createElement('div');
        t.className = 'toast';
        t.style.borderLeft = `4px solid ${type === 'error' ? '#dc2626' : '#059669'}`;
        t.innerHTML = `<i class="fas ${type === 'error' ? 'fa-circle-xmark' : 'fa-check-circle'}" style="color:${type === 'error' ? '#dc2626' : '#059669'};"></i> <span>${msg}</span>`;
        c.appendChild(t);
        setTimeout(() => t.remove(), 3000);
      }

      async function fetchProducts() {
        try {
          const res = await fetch('/api/adminrisman/pos/products?per_page=100');
          if (!res.ok) throw new Error('Network error');
          const data = await res.json();
          products = Array.isArray(data) ? data : data.products || data.data || [];
          updateStokStats();
          renderStokTable();
        } catch (err) {
          showToast('Gagal memuat produk dari server', 'error');
        }
      }

      function updateStokStats() {
        const totalEl = document.getElementById('stokStatTotal');
        if (!totalEl) return;
        totalEl.textContent = String(products.length || 0);
        let low = 0, out = 0;
        products.forEach(p => {
          const qty = Number(p.stock_quantity || 0);
          if (qty <= 0) out++;
          else if (qty <= 5) low++;
        });
        document.getElementById('stokStatLow').textContent = String(low);
        document.getElementById('stokStatOut').textContent = String(out);
      }

      function renderStokTable() {
        const tbody = document.getElementById('stokTableBody');
        if (!tbody) return;
        const searchInput = document.getElementById('searchStok');
        const search = (searchInput ? searchInput.value : '').toLowerCase();
        let filtered = products.filter(p => (p.name || '').toLowerCase().includes(search));

        if (activeStokFilter === 'low') {
          filtered = filtered.filter(p => {
            const qty = Number(p.stock_quantity || 0);
            return qty > 0 && qty <= 5;
          });
        } else if (activeStokFilter === 'out') {
          filtered = filtered.filter(p => Number(p.stock_quantity || 0) <= 0);
        }

        if (!filtered.length) {
          tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; padding:40px; color:var(--muted);">Tidak ada data stok produk</td></tr>';
          return;
        }

        tbody.innerHTML = filtered.map(p => {
          const qty = Number(p.stock_quantity || 0);
          const price = Number(p.price || p.regular_price || 0);
          let badgeStatus = '<span style="padding:4px 10px; border-radius:999px; background:rgba(15,159,110,0.1); color:var(--accent); font-size:11px; font-weight:800;">Tersedia</span>';
          if (qty <= 0) {
            badgeStatus = '<span style="padding:4px 10px; border-radius:999px; background:rgba(225,29,72,0.1); color:var(--danger); font-size:11px; font-weight:800;">Habis</span>';
          } else if (qty <= 5) {
            badgeStatus = '<span style="padding:4px 10px; border-radius:999px; background:rgba(217,119,6,0.1); color:var(--warn); font-size:11px; font-weight:800;">Rendah</span>';
          }

          return `
            <tr style="border-bottom:1px solid rgba(15,23,42,0.05);">
              <td style="padding:14px 18px; font-weight:700; color:var(--fg);">${p.name}</td>
              <td style="padding:14px 18px; font-weight:600; color:var(--muted);">${formatRp(price)}</td>
              <td style="padding:14px 18px; text-align:center; font-weight:800; font-size:15px;">${qty}</td>
              <td style="padding:14px 18px; text-align:center;">${badgeStatus}</td>
              <td style="padding:14px 18px; text-align:center;">
                <button class="btn" style="padding:6px 12px; font-size:12px; border:1px solid #cbd5e1; background:white;" data-edit-stok-id="${p.id}">
                  <i class="fas fa-edit"></i> Edit Stok
                </button>
              </td>
            </tr>
          `;
        }).join('');
      }

      function openEditStokModal(productId) {
        selectedStokProduct = products.find(p => String(p.id) === String(productId));
        if (!selectedStokProduct) return;
        document.getElementById('modalStokProductName').textContent = selectedStokProduct.name;
        document.getElementById('modalStokQtyInput').value = selectedStokProduct.stock_quantity || 0;
        document.getElementById('modalEditStok').classList.add('show');
      }

      async function saveStokUpdate() {
        if (!selectedStokProduct) return;
        const newQty = Number(document.getElementById('modalStokQtyInput').value);
        if (isNaN(newQty) || newQty < 0) {
          showToast('Jumlah stok tidak valid', 'error');
          return;
        }

        const btn = document.getElementById('btnSaveEditStok');
        btn.disabled = true;
        btn.textContent = 'Menyimpan...';

        try {
          const res = await fetch('/api/adminrisman/pos/products', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: selectedStokProduct.id, stock_quantity: newQty }),
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.message || 'Gagal mengubah stok di server');

          selectedStokProduct.stock_quantity = newQty;
          updateStokStats();
          renderStokTable();
          document.getElementById('modalEditStok').classList.remove('show');
          showToast(`Stok ${selectedStokProduct.name} diperbarui menjadi ${newQty}`);
        } catch (err) {
          showToast(err.message || 'Gagal mengubah stok', 'error');
        } finally {
          btn.disabled = false;
          btn.textContent = 'Simpan';
          selectedStokProduct = null;
        }
      }

      async function updateOrderStatus(orderId, status) {
        try {
          const res = await fetch(`/api/adminrisman/orders/${orderId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status })
          });
          if (!res.ok) throw new Error('Gagal memperbarui status order');
          showToast(`Order #${orderId} berhasil diubah ke ${status}`);
          fetchWebOrders();
        } catch (err) {
          showToast(err.message || 'Gagal memproses order', 'error');
        }
      }

      async function fetchWebOrders() {
        const grid = document.getElementById('codOrdersGrid');
        const empty = document.getElementById('codOrdersEmpty');
        if (!grid) return;

        try {
          const res = await fetch('/api/adminrisman/orders?status=pending,on-hold');
          const data = await res.json();
          const orders = Array.isArray(data) ? data : (data.orders || data.data || []);

          if (!orders.length) {
            grid.innerHTML = '';
            if (empty) empty.style.display = 'block';
            return;
          }

          if (empty) empty.style.display = 'none';
          grid.innerHTML = orders.map((order) => {
            const orderDate = order.date_created ? new Date(order.date_created).toLocaleString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '-';
            const phone = order.billing?.phone || order.shipping?.phone || order.phone || '-';
            const note = order.customer_note || order.note || '';
            const items = (order.line_items || []).map((item) => `<li style="margin-bottom:4px;">• <strong>${item.name}</strong> x${item.quantity}</li>`).join('');

            return `
              <div style="background: #ffffff; border: 1.5px solid #cbd5e1; border-radius: 20px; padding: 22px; display: flex; flex-direction: column; justify-content: space-between;">
                <div>
                  <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom: 6px;">
                    <div>
                      <span style="font-size:12px; font-weight:700; color:var(--muted); display:block;">${order.number || `ORD-${order.id}`}</span>
                      <h3 style="font-weight:800; font-size:19px; color:var(--fg); margin-top:2px;">${order.customer_name || order.billing?.first_name || 'Pelanggan'}</h3>
                    </div>
                    <span style="padding:4px 12px; border-radius:999px; background:#fef3c7; color:#d97706; font-size:11px; font-weight:800; letter-spacing:0.05em; text-transform:uppercase;">PENDING</span>
                  </div>

                  <div style="font-size:13px; color:var(--muted); margin-bottom: 12px;">${orderDate}</div>

                  <div style="display:flex; gap:8px; margin-bottom:14px; flex-wrap:wrap;">
                    <span style="padding:4px 10px; border-radius:8px; background:#dcfce7; color:#166534; font-size:12px; font-weight:700;">QRIS</span>
                    <span style="padding:4px 10px; border-radius:8px; background:#e0f2fe; color:#0369a1; font-size:12px; font-weight:700;">🛵 Kurir Express</span>
                  </div>

                  <div style="font-size:13px; color:var(--muted); margin-bottom:8px;">Telepon: ${phone}</div>

                  <ul style="margin:4px 0 16px 12px; padding:0; color:var(--fg); font-size:13px; line-height:1.6; list-style:none;">
                    ${items || '<li>• Produk tidak tersedia</li>'}
                  </ul>
                </div>

                <div>
                  <div style="border-top: 1px dashed #cbd5e1; margin: 12px 0;"></div>

                  <div style="display:flex; justify-content:space-between; align-items:center;">
                    <div>
                      <div style="font-size:12px; color:var(--muted); font-weight:600;">Total</div>
                      <div style="font-weight:800; color:var(--accent); font-size:20px;">${formatRp(Number(order.total || 0))}</div>
                    </div>
                    <button class="btn" style="background:transparent; border:none; color:var(--fg); font-weight:700; font-size:14px; cursor:pointer;" onclick="updateOrderStatus(${order.id}, 'completed')">
                      Konfirmasi
                    </button>
                  </div>

                  ${note ? `
                    <div style="margin-top:14px; background:#fef3c7; border-radius:12px; padding:10px 14px; font-size:13px; color:#92400e;">
                      <strong>Catatan:</strong> ${note}
                    </div>
                  ` : ''}
                </div>
              </div>
            `;
          }).join('');
        } catch (err) {
          showToast('Gagal memuat order dari WooCommerce', 'error');
        }
      }

      async function fetchHistoryOrders() {
        const tbody = document.getElementById('histTableBody');
        try {
          const res = await fetch('/api/adminrisman/orders?status=completed');
          const data = await res.json();
          historyOrders = Array.isArray(data) ? data : (data.orders || data.data || []);

          document.getElementById('histStatTotal').textContent = String(historyOrders.length || 0);
          let totalOmset = 0;
          historyOrders.forEach(o => totalOmset += Number(o.total || 0));
          document.getElementById('histStatOmset').textContent = formatRp(totalOmset);
          renderHistoryTable();
        } catch (err) {
          if (tbody) tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:40px; color:var(--danger);">Gagal memuat histori transaksi</td></tr>';
        }
      }

      function openHistoryDetailModal(orderId) {
        const order = historyOrders.find(o => String(o.id) === String(orderId));
        if (!order) return;

        const modal = document.getElementById('modalDetailHistori');
        const titleEl = document.getElementById('modalHistTitle');
        const badgeEl = document.getElementById('modalHistBadge');
        const contentEl = document.getElementById('modalHistContent');

        if (!modal || !contentEl) return;

        const dateStr = order.date_created ? new Date(order.date_created).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) : '-';
        const items = (order.line_items || []).map(item => `
          <div style="display:flex; justify-content:space-between; align-items:center; padding:8px 0; border-bottom:1px dashed #e2e8f0; font-size:13px;">
            <div>
              <div style="font-weight:700; color:var(--fg);">${item.name}</div>
              <div style="color:var(--muted); font-size:12px;">${formatRp(Number(item.price || 0))} x ${item.quantity}</div>
            </div>
            <div style="font-weight:700; color:var(--fg);">${formatRp(Number(item.total || (item.price * item.quantity) || 0))}</div>
          </div>
        `).join('');

        titleEl.textContent = `Order #${order.number || order.id}`;
        badgeEl.textContent = 'SELESAI';
        badgeEl.style.background = 'rgba(15,159,110,0.1)';
        badgeEl.style.color = 'var(--accent)';

        contentEl.innerHTML = `
          <div style="margin-bottom:16px;">
            <div style="display:flex; justify-content:space-between; font-size:13px; margin-bottom:6px;">
              <span style="color:var(--muted);">Pelanggan:</span>
              <strong style="color:var(--fg);">${order.customer_name || order.billing?.first_name || 'Pelanggan'}</strong>
            </div>
            <div style="display:flex; justify-content:space-between; font-size:13px; margin-bottom:6px;">
              <span style="color:var(--muted);">Tanggal:</span>
              <span style="color:var(--fg);">${dateStr}</span>
            </div>
            <div style="display:flex; justify-content:space-between; font-size:13px; margin-bottom:6px;">
              <span style="color:var(--muted);">Metode Pembayaran:</span>
              <span style="color:var(--fg); font-weight:600;">${order.payment_method_title || 'Tunai / POS'}</span>
            </div>
          </div>

          <div style="font-size:12px; font-weight:700; color:var(--muted); text-transform:uppercase; margin-bottom:8px;">Rincian Produk</div>
          <div style="max-height:220px; overflow-y:auto; margin-bottom:16px;">
            ${items || '<div style="color:var(--muted); font-size:13px;">Tidak ada rincian item.</div>'}
          </div>

          <div style="display:flex; justify-content:space-between; align-items:center; padding-top:12px; border-top:1.5px solid #cbd5e1;">
            <span style="font-weight:700; font-size:14px; color:var(--fg);">Total Transaksi</span>
            <span style="font-weight:800; font-size:18px; color:var(--accent);">${formatRp(Number(order.total || 0))}</span>
          </div>
        `;

        modal.classList.add('show');
      }

      function renderHistoryTable() {
        const tbody = document.getElementById('histTableBody');
        if (!tbody) return;
        const searchInput = document.getElementById('searchHistory');
        const search = (searchInput ? searchInput.value : '').toLowerCase();
        const filtered = historyOrders.filter(o => {
          const num = (o.number || `ORD-${o.id}`).toLowerCase();
          const name = (o.customer_name || 'Pelanggan').toLowerCase();
          return num.includes(search) || name.includes(search);
        });

        if (!filtered.length) {
          tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:40px; color:var(--muted);">Tidak ada riwayat transaksi ditemukan</td></tr>';
          return;
        }

        tbody.innerHTML = filtered.map(o => {
          const dateStr = o.date_created ? new Date(o.date_created).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) : '-';
          return `
            <tr style="border-bottom:1px solid rgba(15,23,42,0.05);">
              <td style="padding:14px 18px; font-weight:700;">${o.number || `ORD-${o.id}`}</td>
              <td style="padding:14px 18px; color:var(--muted); font-size:13px;">${dateStr}</td>
              <td style="padding:14px 18px; font-weight:600;">${o.customer_name || 'Pelanggan'}</td>
              <td style="padding:14px 18px;"><span style="padding:4px 8px; border-radius:6px; background:rgba(15,159,110,0.1); color:var(--accent); font-size:12px; font-weight:700;">${o.payment_method_title || 'Tunai / POS'}</span></td>
              <td style="padding:14px 18px; text-align:right; font-weight:800; color:var(--accent);">${formatRp(Number(o.total || 0))}</td>
              <td style="padding:14px 18px; text-align:center;">
                <button class="btn" style="padding:6px 12px; font-size:12px; border:1px solid #cbd5e1; background:white;" data-view-hist-id="${o.id}">
                  <i class="fas fa-eye"></i> Detail
                </button>
              </td>
            </tr>
          `;
        }).join('');
      }

      window.addEventListener('DOMContentLoaded', () => {
        // NAV SWITCH TAB PAGE
        document.querySelectorAll('.nav-item[data-page]').forEach((item) => {
          item.addEventListener('click', () => {
            const pageTarget = item.dataset.page;
            document.querySelectorAll('.nav-item').forEach((n) => n.classList.remove('active'));
            document.querySelectorAll('.page').forEach((p) => p.classList.remove('active'));
            item.classList.add('active');
            
            const targetId = pageTarget === 'cod' ? 'pageCod' : `page${pageTarget.charAt(0).toUpperCase() + pageTarget.slice(1)}`;
            const el = document.getElementById(targetId);
            if (el) el.classList.add('active');

            if (pageTarget === 'stok') fetchProducts();
            if (pageTarget === 'cod') fetchWebOrders();
            if (pageTarget === 'histori') fetchHistoryOrders();
          });
        });

        // STOK EVENT HANDLERS
        const searchStok = document.getElementById('searchStok');
        if (searchStok) searchStok.addEventListener('input', renderStokTable);
        
        const btnRefreshStok = document.getElementById('btnRefreshStok');
        if (btnRefreshStok) btnRefreshStok.addEventListener('click', fetchProducts);
        
        const btnCancelEditStok = document.getElementById('btnCancelEditStok');
        if (btnCancelEditStok) btnCancelEditStok.addEventListener('click', () => {
          document.getElementById('modalEditStok').classList.remove('show');
        });

        const btnSaveEditStok = document.getElementById('btnSaveEditStok');
        if (btnSaveEditStok) btnSaveEditStok.addEventListener('click', saveStokUpdate);

        document.querySelectorAll('.stok-filter-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('.stok-filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            activeStokFilter = btn.dataset.stokFilter;
            renderStokTable();
          });
        });

        const stokTableBody = document.getElementById('stokTableBody');
        if (stokTableBody) {
          stokTableBody.addEventListener('click', (e) => {
            const btn = e.target.closest('[data-edit-stok-id]');
            if (!btn) return;
            openEditStokModal(btn.getAttribute('data-edit-stok-id'));
          });
        }

        // HISTORI EVENT HANDLERS
        const searchHistory = document.getElementById('searchHistory');
        if (searchHistory) searchHistory.addEventListener('input', renderHistoryTable);
        
        const btnRefreshHistory = document.getElementById('btnRefreshHistory');
        if (btnRefreshHistory) btnRefreshHistory.addEventListener('click', fetchHistoryOrders);

        const histTableBody = document.getElementById('histTableBody');
        if (histTableBody) {
          histTableBody.addEventListener('click', (e) => {
            const btn = e.target.closest('[data-view-hist-id]');
            if (!btn) return;
            openHistoryDetailModal(btn.getAttribute('data-view-hist-id'));
          });
        }

        const btnCloseDetailHist = document.getElementById('btnCloseDetailHist');
        if (btnCloseDetailHist) {
          btnCloseDetailHist.addEventListener('click', () => {
            const modal = document.getElementById('modalDetailHistori');
            if (modal) modal.classList.remove('show');
          });
        }

        // LOGOUT MODAL HANDLERS
        const navLogout = document.getElementById('navLogout');
        if (navLogout) navLogout.addEventListener('click', () => document.getElementById('modalConfirmLogout').classList.add('show'));
        
        const btnCancelLogout = document.getElementById('btnCancelLogout');
        if (btnCancelLogout) btnCancelLogout.addEventListener('click', () => document.getElementById('modalConfirmLogout').classList.remove('show'));
        
        const btnExecuteLogout = document.getElementById('btnExecuteLogout');
        if (btnExecuteLogout) {
          btnExecuteLogout.addEventListener('click', () => {
            localStorage.removeItem('admin_session');
            window.location.replace('/login?from=admin');
          });
        }

        const btnRefreshCodOrders = document.getElementById('btnRefreshCodOrders');
        if (btnRefreshCodOrders) btnRefreshCodOrders.addEventListener('click', fetchWebOrders);
      });
    </script>
  </body>
</html>