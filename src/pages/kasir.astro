---
export const prerender = false;
import POSApp from '@components/pos/POSApp';

const title = 'Kasir LaSayurku';
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <style is:global>
      :root {
        --bg: #f8fafc;
        --card: #ffffff;
        --border: #e2e8f0;
        --fg: #0f172a;
        --muted: #64748b;
        --accent: #16803d;
        --accent-strong: #14532d;
        --accent-soft: rgba(22, 128, 61, 0.08);
        --danger: #e11d48;
        --danger-soft: rgba(225, 29, 72, 0.08);
        --warn: #d97706;
        --shadow: 0 4px 20px rgba(15, 23, 42, 0.05);
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'DM Sans', sans-serif;
        background: var(--bg);
        color: var(--fg);
        min-height: 100vh;
      }
      h1, h2, h3, h4, h5 { font-family: 'Space Grotesk', sans-serif; }
      button, input, select { font: inherit; }

      .sidebar {
        position: fixed; left: 0; top: 0; bottom: 0; width: 84px; background: #ffffff;
        border-right: 1.5px solid var(--border);
        display: flex; flex-direction: column; align-items: center; padding: 20px 0 18px; z-index: 50;
      }
      .logo {
        width: 46px; height: 46px; background: linear-gradient(135deg, #16803d, #14532d);
        border-radius: 15px; display: flex; align-items: center; justify-content: center; font-weight: 800; color: white;
        margin-bottom: 26px; box-shadow: 0 10px 20px rgba(22,128,61,0.25);
      }
      .nav-group { display: flex; flex-direction: column; align-items: center; gap: 8px; width: 100%; }
      .nav-item {
        width: 52px; height: 52px; border-radius: 16px; display: flex; align-items: center; justify-content: center;
        color: var(--muted); cursor: pointer; transition: all 0.2s ease; font-size: 18px;
        border: 1px solid transparent; background: transparent;
      }
      .nav-item.active {
        background: var(--accent-soft); color: var(--accent); border-color: rgba(22, 128, 61, 0.2);
      }
      .nav-item.nav-cod.active { background: rgba(245,158,11,0.12); color: #b45309; }
      .nav-spacer { flex: 1; }

      .main { margin-left: 84px; padding: 24px 28px 32px; min-height: 100vh; }
      .page { display: none; }
      .page.active { display: block; }

      .input, select.input {
        background: #f1f5f9 !important; border: 1px solid transparent !important; border-radius: 999px; padding: 12px 20px; color: var(--fg); font-size: 14px; width: 100%; outline: none; transition: all 0.2s ease;
      }
      .input:focus { background: #ffffff !important; border-color: var(--accent) !important; box-shadow: 0 0 0 3px rgba(22,128,61,0.1); }
      select.input { appearance: none; cursor: pointer; }

      .btn {
        border: none; border-radius: 12px; font-weight: 700; cursor: pointer; transition: all 0.2s ease;
        display: inline-flex; align-items: center; justify-content: center; gap: 6px;
      }
      .btn:hover { transform: translateY(-1px); }
      .btn-primary {
        background: var(--accent);
        color: white; box-shadow: 0 4px 12px rgba(22, 128, 61, 0.2);
      }
      .btn-danger { background: var(--danger-soft); color: var(--danger); border: 1px solid rgba(225,29,72,0.2); }

      .toast-container { position: fixed; top: 24px; right: 24px; z-index: 200; display: flex; flex-direction: column; gap: 10px; }
      .toast { background: rgba(255,255,255,0.95); border: 1px solid var(--border); border-radius: 14px; padding: 12px 16px; display: flex; align-items: center; gap: 10px; font-size: 14px; box-shadow: var(--shadow); }
      .modal-overlay { position: fixed; inset: 0; background: rgba(15,23,42,0.4); backdrop-filter: blur(4px); z-index: 100; display: none; align-items: center; justify-content: center; }
      .modal-overlay.show { display: flex; }
      .modal { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 24px; padding: 28px; width: min(92vw, 480px); box-shadow: 0 20px 50px rgba(0,0,0,0.15); }

      .page-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 20px; }
      .page-header h1 { font-size: clamp(1.6rem, 2vw, 2.2rem); font-weight: 800; margin: 0; color: var(--fg); }
      .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px; margin-bottom: 20px; }
      .stat-card { background: #ffffff !important; border: 1px solid #e2e8f0 !important; border-radius: 18px; padding: 18px; box-shadow: var(--shadow); }
      .stat-label { font-size: 10px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 700; }
      .stat-value { font-size: clamp(1.4rem, 2vw, 2rem); font-weight: 800; margin-top: 4px; }
      .muted { color: var(--muted); }

      .tab-filter-bar {
        display: flex; gap: 6px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 999px; padding: 4px; flex-wrap: wrap;
      }
      .tab-btn {
        border: none; border-radius: 999px; padding: 8px 16px; font-size: 13px; font-weight: 600; color: var(--muted); background: transparent; cursor: pointer; transition: all 0.2s ease;
      }
      .tab-btn:hover { color: var(--fg); }
      .tab-btn.active { background: var(--accent); color: white; box-shadow: 0 2px 6px rgba(22,128,61,0.2); }

      .order-list { display: flex; flex-direction: column; gap: 16px; }
      .order-card {
        background: #ffffff; border: 1px solid #e2e8f0; border-radius: 20px; padding: 20px; display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; transition: box-shadow 0.2s ease;
      }
      .order-card:hover { box-shadow: 0 8px 24px rgba(15,23,42,0.06); }
      .order-info { flex: 1; min-width: 0; }
      .order-meta { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; flex-wrap: wrap; }
      .order-id { font-size: 12px; font-weight: 800; color: var(--muted); letter-spacing: 0.05em; }
      .order-customer { font-size: 16px; font-weight: 800; color: var(--fg); margin-bottom: 6px; }
      .order-address { font-size: 13px; color: var(--muted); display: flex; align-items: center; gap: 6px; }
      .order-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
      .status-badge { padding: 6px 12px; border-radius: 999px; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; }
      .status-pending { background: #fef3c7; color: #d97706; }
      .status-processing { background: #dbeafe; color: #2563eb; }
      .status-completed { background: #dcfce7; color: #16803d; }
      .status-cancelled { background: #fee2e2; color: #dc2626; }

      @media (max-width: 860px) {
        .stok-layout-container { flex-direction: column !important; }
        .subcat-sidebar { width: 100% !important; }
        .sidebar { position: sticky; top: 0; width: 100%; height: auto; border-right: none; border-bottom: 1.5px solid #cbd5e1; padding: 12px 14px; flex-direction: row; justify-content: space-between; }
        .logo { margin: 0; }
        .nav-group { flex-direction: row; gap: 10px; }
        .nav-spacer { display: none; }
        .main { margin-left: 0; padding: 18px 14px 26px; }
        .order-card { flex-direction: column; }
        .order-actions { width: 100%; flex-direction: row; justify-content: space-between; align-items: center; }
      }
    </style>
  </head>
  <body>
    <div class="toast-container" id="toastContainer"></div>

    <nav class="sidebar" aria-label="Menu utama">
      <div class="logo">K</div>
      <div class="nav-group">
        <div class="nav-item active" data-page="kasir" title="Kasir Offline"><i class="fas fa-cash-register"></i></div>
        <div class="nav-item" data-page="stok" title="Stok"><i class="fas fa-warehouse"></i></div>
        <div class="nav-item" data-page="histori" title="Histori Penjualan"><i class="fas fa-clock-rotate-left"></i></div>
        <div class="nav-item nav-cod" data-page="cod" title="Orderan COD"><i class="fas fa-motorcycle"></i></div>
      </div>
      <div class="nav-spacer"></div>
      <div class="nav-item" id="navLogout" title="Keluar"><i class="fas fa-right-from-bracket" style="color: var(--danger);"></i></div>
    </nav>

    <main class="main">
      <section class="page active" id="pageKasir">
        <div id="kasir-offline-root" class="min-h-screen bg-slate-50 text-slate-900 rounded-2xl overflow-hidden p-2">
          <POSApp client:only="react" />
        </div>
      </section>

      <section class="page" id="pageStok">
        <div class="page-header">
          <div>
            <h1>Manajemen Stok</h1>
            <p class="muted" style="margin-top:4px;">Sinkronisasi otomatis dari server WooCommerce.</p>
          </div>
          <button id="btnOpenUpdateStokModal" class="btn btn-primary" style="padding:10px 18px;">
            <i class="fas fa-boxes" style="margin-right:6px;"></i> Update Stok
          </button>
        </div>

        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-label">Produk Aktif</div>
            <div class="stat-value" id="stokStatTotal">0</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Stok Rendah (&le;5)</div>
            <div class="stat-value" id="stokStatLow" style="color:var(--warn);">0</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Stok Habis</div>
            <div class="stat-value" id="stokStatOut" style="color:var(--danger);">0</div>
          </div>
        </div>

        <div class="stok-layout-container" style="display: flex; gap: 24px; align-items: flex-start;">
          <aside class="subcat-sidebar" style="width: 220px; flex-shrink: 0; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 20px; padding: 18px 14px; box-shadow: var(--shadow);">
            <div style="font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); margin-bottom: 2px;">Sub Kategori</div>
            <div id="subcatTitleMain" style="font-size: 16px; font-weight: 800; color: var(--fg); margin-bottom: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Semua Produk</div>
            <div id="subcatList" style="display: flex; flex-direction: column; gap: 4px;"></div>
          </aside>

          <div style="flex: 1; min-width: 0;">
            <div style="display: flex; gap: 12px; margin-bottom: 20px; align-items: center; flex-wrap: wrap;">
              <div style="position: relative; flex: 1; min-width: 240px;">
                <i class="fas fa-search" style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--muted);"></i>
                <input type="text" class="input" id="searchStok" placeholder="Cari sayur, buah, atau bahan dapur..." style="padding-left: 44px;" />
              </div>
              <div style="display: flex; gap: 6px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 999px; padding: 4px;">
                <button class="stok-filter-btn active" data-stok-filter="all" style="border:none; border-radius:999px; padding:6px 14px; font-size:12px;">Semua</button>
                <button class="stok-filter-btn" data-stok-filter="low" style="border:none; border-radius:999px; padding:6px 14px; font-size:12px;">Stok Rendah</button>
                <button class="stok-filter-btn" data-stok-filter="out" style="border:none; border-radius:999px; padding:6px 14px; font-size:12px;">Stok Habis</button>
              </div>
            </div>

            <div id="stokGridView" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 16px; margin-bottom: 20px;"></div>
          </div>
        </div>
      </section>

      <section class="page" id="pageHistori">
        <div class="page-header">
          <div>
            <h1>Histori Penjualan</h1>
            <p class="muted" style="margin-top:6px;">Catatan transaksi sukses dari kasir POS dan WooCommerce.</p>
          </div>
          <button id="btnRefreshHistory" class="btn btn-primary" style="padding:10px 16px;">
            <i class="fas fa-sync-alt" style="margin-right:6px;"></i> Refresh
          </button>
        </div>

        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-label">Total Transaksi Selesai</div>
            <div class="stat-value" id="histStatTotal">0</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Total Pendapatan</div>
            <div class="stat-value" id="histStatOmset" style="color:var(--accent);">Rp 0</div>
          </div>
        </div>

        <div class="card" style="padding:0; overflow:hidden; background:#fff; border:1px solid #e2e8f0; border-radius:20px;">
          <div style="padding:16px; border-bottom:1px solid #e2e8f0; display:flex; gap:12px;">
            <div style="position:relative; flex:1;">
              <i class="fas fa-search" style="position:absolute; left:14px; top:50%; transform:translateY(-50%); color:var(--muted);"></i>
              <input type="text" class="input" id="searchHistory" placeholder="Cari No. Order atau Pelanggan..." style="padding-left:40px;" />
            </div>
          </div>
          <div style="overflow-x:auto;">
            <table style="width:100%; border-collapse:collapse; text-align:left; font-size:14px;">
              <thead>
                <tr style="background:#f8fafc; border-bottom:1px solid #e2e8f0; color:var(--muted); font-size:12px; text-transform:uppercase;">
                  <th style="padding:14px 18px;">No. Order</th>
                  <th style="padding:14px 18px;">Tanggal</th>
                  <th style="padding:14px 18px;">Pelanggan</th>
                  <th style="padding:14px 18px;">Metode</th>
                  <th style="padding:14px 18px; text-align:right;">Total</th>
                  <th style="padding:14px 18px; text-align:center;">Aksi</th>
                </tr>
              </thead>
              <tbody id="histTableBody">
                <tr><td colspan="6" style="text-align:center; padding:40px; color:var(--muted);">Memuat histori transaksi...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="page" id="pageCod">
        <div class="page-header">
          <div>
            <h1>Orderan COD (Pesanan Web)</h1>
            <p class="muted" style="margin-top:6px;">Konfirmasi pesanan pelanggan yang masuk dari website WooCommerce.</p>
          </div>
          <button id="btnRefreshCodOrders" class="btn btn-primary" style="padding:10px 16px;">
            <i class="fas fa-sync-alt" id="iconRefreshCod" style="margin-right:6px;"></i> Refresh
          </button>
        </div>

        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-label">Total Orderan</div>
            <div class="stat-value" id="codStatTotal">0</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Menunggu Pembayaran</div>
            <div class="stat-value" id="codStatPending" style="color:var(--warn);">0</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Sudah Dibayar / Diproses</div>
            <div class="stat-value" id="codStatPaid" style="color:var(--accent);">0</div>
          </div>
        </div>

        <div style="display: flex; gap: 12px; margin-bottom: 20px; align-items: center; flex-wrap: wrap;">
          <div style="position: relative; flex: 1; min-width: 240px;">
            <i class="fas fa-search" style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--muted);"></i>
            <input type="text" class="input" id="searchCod" placeholder="Cari nama pelanggan atau no order..." style="padding-left: 44px;" />
          </div>
          <div class="tab-filter-bar">
            <button class="tab-btn active" data-cod-status="all">Semua</button>
            <button class="tab-btn" data-cod-status="pending,on-hold">Menunggu Bayar</button>
            <button class="tab-btn" data-cod-status="processing">Diproses</button>
            <button class="tab-btn" data-cod-status="completed">Selesai</button>
          </div>
        </div>

        <div class="order-list" id="codOrdersList">
          <div style="text-align:center; padding:40px; color:var(--muted);">Memuat data pesanan...</div>
        </div>
      </section>
    </main>

    <!-- MODAL UPDATE STOK -->
    <div class="modal-overlay" id="modalUpdateStok">
      <div class="modal" style="max-width: 420px;">
        <h3 style="font-size: 20px; font-weight: 800; margin-bottom: 20px; display:flex; align-items:center; gap:8px;">
          <i class="fas fa-boxes" style="color:var(--accent);"></i> Update Stok
        </h3>
        
        <div style="margin-bottom:16px;">
          <label style="font-size: 12px; font-weight: 700; color: var(--muted); display: block; margin-bottom: 6px; text-transform: uppercase;">Pilih Produk</label>
          <select id="updateStokProductSelect" class="input" style="border-radius:12px !important;">
            <option value="">Memuat produk...</option>
          </select>
        </div>

        <div style="display:flex; gap:12px; margin-bottom:16px;">
          <div style="flex:1;">
            <label style="font-size: 12px; font-weight: 700; color: var(--muted); display: block; margin-bottom: 6px; text-transform: uppercase;">Tipe Stok</label>
            <select id="updateStokType" class="input" style="border-radius:12px !important;">
              <option value="in">Stok Masuk (+)</option>
              <option value="out">Stok Keluar (-)</option>
            </select>
          </div>
          <div style="width:120px;">
            <label style="font-size: 12px; font-weight: 700; color: var(--muted); display: block; margin-bottom: 6px; text-transform: uppercase;">Jumlah</label>
            <input type="number" class="input" id="updateStokQty" min="1" value="0" style="font-size: 18px; font-weight: 700; text-align: center; border-radius:12px !important;" />
          </div>
        </div>

        <div style="margin-bottom:24px;">
          <label style="font-size: 12px; font-weight: 700; color: var(--muted); display: block; margin-bottom: 6px; text-transform: uppercase;">Catatan (Opsional)</label>
          <input type="text" class="input" id="updateStokNote" placeholder="Contoh: restock dari supplier" style="border-radius:12px !important;" />
        </div>

        <div style="display: flex; gap: 10px;">
          <button class="btn" style="flex: 1; border: 1px solid #e2e8f0; background: white; padding: 12px;" id="btnCancelUpdateStok">Batal</button>
          <button class="btn btn-primary" style="flex: 1; padding: 12px;" id="btnSubmitUpdateStok">Update</button>
        </div>
      </div>
    </div>

    <!-- MODAL DETAIL PESANAN -->
    <div class="modal-overlay" id="modalDetailHistori">
      <div class="modal" style="max-width: 520px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid #e2e8f0;">
          <h3 style="font-size:20px; font-weight:800; margin:0;" id="modalHistTitle">Detail Transaksi</h3>
          <span id="modalHistBadge" style="padding:4px 10px; border-radius:999px; font-size:11px; font-weight:800;"></span>
        </div>
        <div id="modalHistContent"></div>
        <div style="margin-top:20px; text-align:right;">
          <button class="btn" style="border:1px solid #e2e8f0; background:white; padding:10px 20px;" id="btnCloseDetailHist">Tutup</button>
        </div>
      </div>
    </div>

    <!-- MODAL KONFIRMASI PEMBAYARAN (BARU) -->
    <div class="modal-overlay" id="modalConfirmPayment">
      <div class="modal" style="max-width: 380px; text-align: center;">
        <div style="width: 60px; height: 60px; border-radius: 20px; background: rgba(22,128,61,0.1); color: var(--accent); display: flex; align-items: center; justify-content: center; font-size: 26px; margin: 0 auto 16px;">
          <i class="fas fa-circle-check"></i>
        </div>
        <h3 style="font-size: 20px; font-weight: 800; margin-bottom: 8px;">Konfirmasi Pembayaran</h3>
        <p style="color: var(--muted); font-size: 14px; margin-bottom: 24px;">Apakah pembayaran pesanan ini sudah masuk dan valid?</p>
        <div style="display: flex; gap: 10px;">
          <button class="btn" style="flex: 1; border: 1px solid #e2e8f0; background: white; padding: 12px;" id="btnCancelConfirmPayment">Batal</button>
          <button class="btn btn-primary" style="flex: 1; padding: 12px;" id="btnExecuteConfirmPayment">Ya, Konfirmasi</button>
        </div>
      </div>
    </div>

    <!-- MODAL LOGOUT -->
    <div class="modal-overlay" id="modalConfirmLogout">
      <div class="modal" style="max-width: 380px; text-align: center;">
        <div style="width: 60px; height: 60px; border-radius: 20px; background: rgba(225,29,72,0.1); color: var(--danger); display: flex; align-items: center; justify-content: center; font-size: 26px; margin: 0 auto 16px;">
          <i class="fas fa-right-from-bracket"></i>
        </div>
        <h3 style="font-size: 20px; font-weight: 800; margin-bottom: 8px;">Keluar Kasir</h3>
        <p style="color: var(--muted); font-size: 14px; margin-bottom: 24px;">Apakah Anda yakin ingin keluar dari sistem kasir?</p>
        <div style="display: flex; gap: 10px;">
          <button class="btn" style="flex: 1; border: 1px solid #e2e8f0; background: white; padding: 12px;" id="btnCancelLogout">Batal</button>
          <button class="btn btn-danger" style="flex: 1; padding: 12px; background: var(--danger); color: white;" id="btnExecuteLogout">Ya, Keluar</button>
        </div>
      </div>
    </div>

    <script>
      import { getAdminSession, roleAllowed } from '../lib/adminAuth';

      document.addEventListener('DOMContentLoaded', () => {
        const session = getAdminSession('online') || getAdminSession();
        const allowed = ['kasir', 'kasir_lasayurku', 'administrator', 'admin'];
        if (!session || !roleAllowed(session.role, allowed)) {
          window.location.replace('/login?from=admin&error=denied');
        }
      });
    </script>

    <script is:inline>
      let products = [];
      let historyOrders = [];
      let allCodOrders = []; 
      let activeStokFilter = 'all';
      let activeMainCategory = 'all';
      let activeSubCategory = 'semua';
      let activeCodStatus = 'all';
      let isFetchingCod = false;
      let pendingOrderId = null;

      const formatRp = (v) => `Rp ${Math.round(v || 0).toLocaleString('id-ID')}`;

      function showToast(msg, type = 'success') {
        const c = document.getElementById('toastContainer');
        if (!c) return;
        const t = document.createElement('div');
        t.className = 'toast';
        t.style.borderLeft = `4px solid ${type === 'error' ? '#dc2626' : '#16803d'}`;
        t.innerHTML = `<i class="fas ${type === 'error' ? 'fa-circle-xmark' : 'fa-check-circle'}" style="color:${type === 'error' ? '#dc2626' : '#16803d'};"></i> <span>${msg}</span>`;
        c.appendChild(t);
        setTimeout(() => t.remove(), 3000);
      }

      // ============= STOK FUNCTIONS =============
      function processAndRenderCategories() {
        const listEl = document.getElementById('subcatList');
        if (!listEl) return;
        let subCats = [];
        products.forEach(p => {
          if (Array.isArray(p.categories)) {
            p.categories.forEach(c => {
              if(!subCats.find(sc => sc.id === c.id)) subCats.push(c);
            });
          }
        });

        listEl.innerHTML = `
          <button class="subcat-btn ${activeSubCategory === 'semua' ? 'active' : ''}" data-sub-cat="semua" style="display:flex; justify-content:space-between; width:100%; padding:9px 12px; border-radius:12px; font-size:13px; font-weight:600; background:transparent; border:none; cursor:pointer; color:var(--fg);">
            <span>Semua</span>
          </button>
          ${subCats.map(sc => `
            <button class="subcat-btn ${String(activeSubCategory) === String(sc.id) ? 'active' : ''}" data-sub-cat="${sc.id}" style="display:flex; justify-content:space-between; width:100%; padding:9px 12px; border-radius:12px; font-size:13px; font-weight:600; background:transparent; border:none; cursor:pointer; color:var(--fg);">
              <span>${sc.name}</span>
            </button>
          `).join('')}
        `;
        
        listEl.querySelectorAll('.subcat-btn').forEach(btn => {
          if(btn.classList.contains('active')) {
            btn.style.background = 'var(--accent)';
            btn.style.color = '#ffffff';
          }
          btn.addEventListener('click', () => {
            listEl.querySelectorAll('.subcat-btn').forEach(b => {
              b.classList.remove('active');
              b.style.background = 'transparent';
              b.style.color = 'var(--fg)';
            });
            btn.classList.add('active');
            btn.style.background = 'var(--accent)';
            btn.style.color = '#ffffff';
            activeSubCategory = btn.dataset.subCat;
            renderStokDisplay();
          });
        });
      }

      async function fetchProducts() {
        try {
          const res = await fetch('/api/adminrisman/pos/products?per_page=100');
          if (!res.ok) throw new Error('Gagal memuat data');
          const data = await res.json();
          products = Array.isArray(data) ? data : data.products || data.data || [];
          updateStokStats();
          processAndRenderCategories();
          renderStokDisplay();
          populateUpdateStokDropdown(); 
        } catch (err) {
          showToast('Gagal memuat produk dari server', 'error');
        }
      }

      function populateUpdateStokDropdown() {
        const select = document.getElementById('updateStokProductSelect');
        if (!select) return;
        select.innerHTML = products.map(p => `<option value="${p.id}">${p.name} (Stok: ${p.stock_quantity || 0})</option>`).join('');
      }

      function updateStokStats() {
        const totalEl = document.getElementById('stokStatTotal');
        if (!totalEl) return;
        totalEl.textContent = String(products.length || 0);
        let low = 0, out = 0;
        products.forEach(p => {
          const qty = Number(p.stock_quantity || 0);
          if (qty <= 0) out++;
          else if (qty <= 5) low++;
        });
        document.getElementById('stokStatLow').textContent = String(low);
        document.getElementById('stokStatOut').textContent = String(out);
      }

      function getFilteredProducts() {
        const searchInput = document.getElementById('searchStok');
        const search = (searchInput ? searchInput.value : '').toLowerCase();
        let filtered = products.filter(p => (p.name || '').toLowerCase().includes(search));

        if (activeSubCategory !== 'semua') {
          filtered = filtered.filter(p => {
            const catIds = (p.categories || []).map(c => String(c.id || c.name || c));
            return catIds.includes(String(activeSubCategory));
          });
        }

        if (activeStokFilter === 'low') {
          filtered = filtered.filter(p => Number(p.stock_quantity || 0) > 0 && Number(p.stock_quantity || 0) <= 5);
        } else if (activeStokFilter === 'out') {
          filtered = filtered.filter(p => Number(p.stock_quantity || 0) <= 0);
        }
        return filtered;
      }

      function renderStokDisplay() {
        const gridEl = document.getElementById('stokGridView');
        if (!gridEl) return;
        const filtered = getFilteredProducts();
        if (!filtered.length) {
          gridEl.innerHTML = '<div style="grid-column:1/-1; text-align:center; padding:40px; color:var(--muted);">Tidak ada produk yang sesuai filter</div>';
          return;
        }

        gridEl.innerHTML = filtered.map(p => {
          const qty = Number(p.stock_quantity || 0);
          const price = Number(p.price || p.regular_price || 0);
          const image = p.images?.[0]?.src || p.image || '/placeholder-product.png';
          return `
            <div class="product-card" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 18px; padding: 14px; transition: all 0.2s ease; display: flex; flex-direction: column; justify-content: space-between; height: 100%; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
              <div>
                <div style="width: 100%; aspect-ratio: 1 / 1; background: #ffffff; border-radius: 14px; overflow: hidden; display: flex; align-items: center; justify-content: center; margin-bottom: 12px;">
                  <img src="${image}" alt="${p.name}" style="width: 100%; height: 100%; object-fit: contain; padding: 4px;" onerror="this.src='/placeholder-product.png'" />
                </div>
                <div style="font-size: 13px; font-weight: 700; color: var(--fg); line-height: 1.35; margin-bottom: 4px;">${p.name}</div>
              </div>
              <div>
                <div style="font-size: 14px; font-weight: 800; color: var(--fg); margin-bottom: 2px;">${formatRp(price)}</div>
                <div style="font-size: 12px; font-weight: 600; color: var(--muted); margin-bottom: 10px;">Stok: <strong style="color:${qty <= 0 ? 'var(--danger)' : qty <= 5 ? 'var(--warn)' : 'var(--fg)'};">${qty}</strong></div>
                <button class="btn product-card-action-btn" data-edit-stok-id="${p.id}" style="width: 100%; padding: 8px; font-size: 12px; font-weight: 700; border: 1px solid #e2e8f0; background: #ffffff; border-radius: 10px; color: var(--fg);">
                  <i class="fas fa-edit"></i> Edit Stok
                </button>
              </div>
            </div>
          `;
        }).join('');

        gridEl.querySelectorAll('[data-edit-stok-id]').forEach(btn => {
          btn.addEventListener('click', () => openUpdateStokModal(btn.getAttribute('data-edit-stok-id')));
        });
      }

      function openUpdateStokModal(productId = null) {
        const select = document.getElementById('updateStokProductSelect');
        if (productId && select) select.value = String(productId);
        document.getElementById('updateStokQty').value = 0;
        document.getElementById('updateStokNote').value = '';
        document.getElementById('modalUpdateStok').classList.add('show');
      }

      async function submitUpdateStok() {
        const select = document.getElementById('updateStokProductSelect');
        const productId = select.value;
        const product = products.find(p => String(p.id) === String(productId));
        if (!product) { showToast('Silakan pilih produk', 'error'); return; }

        const type = document.getElementById('updateStokType').value;
        const qty = Number(document.getElementById('updateStokQty').value);
        if (isNaN(qty) || qty <= 0) { showToast('Jumlah stok tidak valid', 'error'); return; }

        const currentStock = Number(product.stock_quantity || 0);
        let newQty = type === 'in' ? currentStock + qty : currentStock - qty;
        if (newQty < 0) newQty = 0;

        const btn = document.getElementById('btnSubmitUpdateStok');
        btn.disabled = true;
        btn.textContent = 'Menyimpan...';

        try {
          const res = await fetch('/api/adminrisman/pos/products', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: product.id, stock_quantity: newQty }),
          });
          if (!res.ok) throw new Error('Gagal mengubah stok');
          
          product.stock_quantity = newQty;
          updateStokStats();
          renderStokDisplay();
          populateUpdateStokDropdown(); 
          document.getElementById('modalUpdateStok').classList.remove('show');
          showToast(`Stok ${product.name} diperbarui menjadi ${newQty}`);
        } catch (err) {
          showToast(err.message || 'Gagal mengubah stok', 'error');
        } finally {
          btn.disabled = false;
          btn.textContent = 'Update';
        }
      }

      // ============= COD ORDERS FUNCTIONS =============
      async function fetchWebOrders() {
        if (isFetchingCod) return;
        isFetchingCod = true;
        const iconRefresh = document.getElementById('iconRefreshCod');
        if (iconRefresh) iconRefresh.classList.add('fa-spin');

        const listEl = document.getElementById('codOrdersList');
        if(listEl) listEl.innerHTML = '<div style="text-align:center; padding:40px; color:var(--muted);">Memuat data pesanan...</div>';

        try {
          const res = await fetch('/api/adminrisman/orders?status=all');
          if (!res.ok) throw new Error('Gagal memuat data');
          const data = await res.json();
          allCodOrders = data.orders || (Array.isArray(data) ? data : []);

          updateCodStats();
          renderCodOrders();
        } catch (err) {
          showToast('Gagal memuat pesanan COD', 'error');
          if(listEl) listEl.innerHTML = '<div style="text-align:center; padding:40px; color:var(--danger);">Gagal memuat data pesanan.</div>';
        } finally {
          isFetchingCod = false;
          if (iconRefresh) iconRefresh.classList.remove('fa-spin');
        }
      }

      function updateCodStats() {
        const total = allCodOrders.length;
        const pending = allCodOrders.filter(o => ['pending', 'on-hold'].includes(o.status)).length;
        const paid = allCodOrders.filter(o => ['processing', 'completed'].includes(o.status)).length;

        document.getElementById('codStatTotal').textContent = total;
        document.getElementById('codStatPending').textContent = pending;
        document.getElementById('codStatPaid').textContent = paid;
      }

      function renderCodOrders() {
        const listEl = document.getElementById('codOrdersList');
        const searchInput = document.getElementById('searchCod');
        const search = (searchInput ? searchInput.value : '').toLowerCase();

        let filtered = allCodOrders;
        if (activeCodStatus !== 'all') {
          const statusArr = activeCodStatus.split(',');
          filtered = filtered.filter(o => statusArr.includes(o.status));
        }

        filtered = filtered.filter(o => {
          const num = (o.number || `ORD-${o.id}`).toLowerCase();
          const name = (o.customer_name || 'Pelanggan').toLowerCase();
          return num.includes(search) || name.includes(search);
        });

        if (!filtered.length) {
          listEl.innerHTML = '<div style="text-align:center; padding:40px; color:var(--muted);">Tidak ada pesanan yang sesuai filter</div>';
          return;
        }

        listEl.innerHTML = filtered.map(order => {
          const address = order.address || order.shipping?.address_1 || order.billing?.address_1 || 'Alamat tidak tersedia';
          const total = Number(order.total || 0);
          
          let statusClass = 'status-pending';
          let statusText = 'Menunggu Pembayaran';
          if (order.status === 'processing') { statusClass = 'status-processing'; statusText = 'Diproses'; }
          if (order.status === 'completed') { statusClass = 'status-completed'; statusText = 'Selesai'; }
          if (order.status === 'cancelled') { statusClass = 'status-cancelled'; statusText = 'Dibatalkan'; }

          const isPending = ['pending', 'on-hold'].includes(order.status);

          return `
            <div class="order-card">
              <div class="order-info">
                <div class="order-meta">
                  <span class="order-id">${order.number || `ORD-${order.id}`}</span>
                  <span style="font-size:12px; color:var(--muted);">•</span>
                  <span style="font-size:12px; color:var(--muted);">${order.date_created ? new Date(order.date_created).toLocaleString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '-'}</span>
                </div>
                <div class="order-customer">${order.customer_name || 'Pelanggan'}</div>
                <div class="order-address">
                  <i class="fas fa-map-marker-alt"></i>
                  <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width: 350px; display:inline-block; vertical-align:bottom;">${address}</span>
                </div>
              </div>
              <div class="order-actions">
                <span class="status-badge ${statusClass}">${statusText}</span>
                <div style="font-weight: 800; color: var(--fg); font-size: 16px; text-align:right;">${formatRp(total)}</div>
                <div style="display:flex; gap:8px; justify-content:flex-end;">
                  <button class="btn" style="padding:8px 12px; font-size:12px; border:1px solid #e2e8f0; background:white; color:var(--fg);" data-view-cod-id="${order.id}">
                    <i class="fas fa-eye"></i> Detail
                  </button>
                  ${isPending ? `
                    <button class="btn btn-primary" style="padding:8px 12px; font-size:12px;" data-confirm-order-id="${order.id}">
                      <i class="fas fa-check"></i> Konfirmasi Bayar
                    </button>
                  ` : ''}
                </div>
              </div>
            </div>
          `;
        }).join('');

        listEl.querySelectorAll('[data-confirm-order-id]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            openConfirmPaymentModal(btn.getAttribute('data-confirm-order-id'));
          });
        });

        listEl.querySelectorAll('[data-view-cod-id]').forEach(btn => {
          btn.addEventListener('click', () => openCodDetailModal(btn.getAttribute('data-view-cod-id')));
        });
      }

      function openConfirmPaymentModal(orderId) {
        pendingOrderId = orderId;
        document.getElementById('modalConfirmPayment').classList.add('show');
      }

      async function executeConfirmPayment() {
        if (!pendingOrderId) return;
        
        const btn = document.getElementById('btnExecuteConfirmPayment');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Memproses...';

        try {
          const res = await fetch('/api/adminrisman/orders', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderId: pendingOrderId, status: 'processing' })
          });
          
          if (!res.ok) throw new Error('Gagal konfirmasi');
          
          showToast('Pesanan berhasil dikonfirmasi!');
          
          // Update status lokal agar langsung berubah tanpa reload
          const order = allCodOrders.find(o => String(o.id) === String(pendingOrderId));
          if(order) order.status = 'processing';
          
          updateCodStats();
          renderCodOrders();
          document.getElementById('modalConfirmPayment').classList.remove('show');
        } catch (err) {
          showToast('Gagal mengkonfirmasi pesanan', 'error');
        } finally {
          btn.disabled = false;
          btn.innerHTML = 'Ya, Konfirmasi';
          pendingOrderId = null;
        }
      }

      function openCodDetailModal(orderId) {
        const order = allCodOrders.find(o => String(o.id) === String(orderId)) || historyOrders.find(o => String(o.id) === String(orderId));
        if (!order) return;

        const modal = document.getElementById('modalDetailHistori');
        const titleEl = document.getElementById('modalHistTitle');
        const badgeEl = document.getElementById('modalHistBadge');
        const contentEl = document.getElementById('modalHistContent');

        const address = order.address || order.shipping?.address_1 || order.billing?.address_1 || '-';
        const items = (order.line_items || []).map(item => `
          <div style="display:flex; justify-content:space-between; align-items:center; padding:8px 0; border-bottom:1px dashed #e2e8f0; font-size:13px;">
            <div>
              <div style="font-weight:700; color:var(--fg);">${item.name}</div>
              <div style="color:var(--muted); font-size:12px;">${formatRp(Number(item.price || item.total || 0))} x ${item.quantity}</div>
            </div>
            <div style="font-weight:700; color:var(--fg);">${formatRp(Number(item.total || (item.price * item.quantity) || 0))}</div>
          </div>
        `).join('');

        titleEl.textContent = `Order #${order.number || order.id}`;
        badgeEl.textContent = order.status ? order.status.toUpperCase() : 'PENDING';
        
        if(order.status === 'completed') {
          badgeEl.style.background = 'rgba(22,128,61,0.1)';
          badgeEl.style.color = 'var(--accent)';
        } else if (order.status === 'processing') {
          badgeEl.style.background = 'rgba(37, 99, 235, 0.1)';
          badgeEl.style.color = '#2563eb';
        } else {
          badgeEl.style.background = 'rgba(217, 119, 6, 0.1)';
          badgeEl.style.color = '#d97706';
        }

        contentEl.innerHTML = `
          <div style="margin-bottom:16px;">
            <div style="display:flex; justify-content:space-between; font-size:13px; margin-bottom:6px;"><span style="color:var(--muted);">Pelanggan:</span><strong style="color:var(--fg);">${order.customer_name || 'Pelanggan'}</strong></div>
            <div style="display:flex; justify-content:space-between; font-size:13px; margin-bottom:6px;"><span style="color:var(--muted);">Telepon:</span><span style="color:var(--fg);">${order.phone || '-'}</span></div>
            <div style="display:flex; justify-content:space-between; font-size:13px; margin-bottom:6px;"><span style="color:var(--muted);">Alamat:</span><span style="color:var(--fg); text-align:right; max-width:300px;">${address}</span></div>
            <div style="display:flex; justify-content:space-between; font-size:13px; margin-bottom:6px;"><span style="color:var(--muted);">Metode Pembayaran:</span><span style="color:var(--fg); font-weight:600;">${order.payment_method_title || 'QRIS / COD'}</span></div>
          </div>
          <div style="font-size:12px; font-weight:700; color:var(--muted); text-transform:uppercase; margin-bottom:8px;">Rincian Produk</div>
          <div style="max-height:220px; overflow-y:auto; margin-bottom:16px;">${items || '<div style="color:var(--muted); font-size:13px;">Tidak ada rincian item.</div>'}</div>
          <div style="display:flex; justify-content:space-between; align-items:center; padding-top:12px; border-top:1.5px solid #e2e8f0;">
            <span style="font-weight:700; font-size:14px; color:var(--fg);">Total Transaksi</span>
            <span style="font-weight:800; font-size:18px; color:var(--accent);">${formatRp(Number(order.total || 0))}</span>
          </div>
        `;
        modal.classList.add('show');
      }

      // ============= HISTORY FUNCTIONS =============
      async function fetchHistoryOrders() {
        const tbody = document.getElementById('histTableBody');
        try {
          const res = await fetch('/api/adminrisman/orders?status=completed');
          if (!res.ok) throw new Error('Gagal memuat data');
          const data = await res.json();
          historyOrders = Array.isArray(data) ? data : (data.orders || data.data || []);

          document.getElementById('histStatTotal').textContent = String(historyOrders.length || 0);
          let totalOmset = 0;
          historyOrders.forEach(o => totalOmset += Number(o.total || 0));
          document.getElementById('histStatOmset').textContent = formatRp(totalOmset);
          renderHistoryTable();
        } catch (err) {
          if (tbody) tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:40px; color:var(--danger);">Gagal memuat histori transaksi</td></tr>';
        }
      }

      function renderHistoryTable() {
        const tbody = document.getElementById('histTableBody');
        if (!tbody) return;
        const searchInput = document.getElementById('searchHistory');
        const search = (searchInput ? searchInput.value : '').toLowerCase();
        const filtered = historyOrders.filter(o => {
          const num = (o.number || `ORD-${o.id}`).toLowerCase();
          const name = (o.customer_name || 'Pelanggan').toLowerCase();
          return num.includes(search) || name.includes(search);
        });

        if (!filtered.length) {
          tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:40px; color:var(--muted);">Tidak ada riwayat transaksi ditemukan</td></tr>';
          return;
        }

        tbody.innerHTML = filtered.map(o => {
          const dateStr = o.date_created ? new Date(o.date_created).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) : '-';
          return `
            <tr style="border-bottom:1px solid rgba(15,23,42,0.05);">
              <td style="padding:14px 18px; font-weight:700;">${o.number || `ORD-${o.id}`}</td>
              <td style="padding:14px 18px; color:var(--muted); font-size:13px;">${dateStr}</td>
              <td style="padding:14px 18px; font-weight:600;">${o.customer_name || 'Pelanggan'}</td>
              <td style="padding:14px 18px;"><span style="padding:4px 8px; border-radius:6px; background:rgba(22,128,61,0.1); color:var(--accent); font-size:12px; font-weight:700;">${o.payment_method_title || 'Tunai / POS'}</span></td>
              <td style="padding:14px 18px; text-align:right; font-weight:800; color:var(--accent);">${formatRp(Number(o.total || 0))}</td>
              <td style="padding:14px 18px; text-align:center;">
                <button class="btn" style="padding:6px 12px; font-size:12px; border:1px solid #e2e8f0; background:white;" data-view-hist-id="${o.id}"><i class="fas fa-eye"></i> Detail</button>
              </td>
            </tr>
          `;
        }).join('');
      }

      // ============= INIT & EVENTS =============
      window.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.nav-item[data-page]').forEach((item) => {
          item.addEventListener('click', () => {
            const pageTarget = item.dataset.page;
            document.querySelectorAll('.nav-item').forEach((n) => n.classList.remove('active'));
            document.querySelectorAll('.page').forEach((p) => p.classList.remove('active'));
            item.classList.add('active');
            const targetId = pageTarget === 'cod' ? 'pageCod' : `page${pageTarget.charAt(0).toUpperCase() + pageTarget.slice(1)}`;
            const el = document.getElementById(targetId);
            if (el) el.classList.add('active');
            if (pageTarget === 'stok') fetchProducts();
            if (pageTarget === 'cod') fetchWebOrders();
            if (pageTarget === 'histori') fetchHistoryOrders();
          });
        });

        document.querySelectorAll('.tab-btn[data-cod-status]').forEach(btn => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            activeCodStatus = btn.dataset.codStatus;
            renderCodOrders();
          });
        });

        const searchCod = document.getElementById('searchCod');
        if (searchCod) searchCod.addEventListener('input', renderCodOrders);

        const btnRefreshCodOrders = document.getElementById('btnRefreshCodOrders');
        if (btnRefreshCodOrders) btnRefreshCodOrders.addEventListener('click', fetchWebOrders);

        const searchStok = document.getElementById('searchStok');
        if (searchStok) searchStok.addEventListener('input', renderStokDisplay);
        
        document.querySelectorAll('.stok-filter-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('.stok-filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            activeStokFilter = btn.dataset.stokFilter;
            renderStokDisplay();
          });
        });

        const btnOpenUpdateStokModal = document.getElementById('btnOpenUpdateStokModal');
        if (btnOpenUpdateStokModal) btnOpenUpdateStokModal.addEventListener('click', () => openUpdateStokModal());

        const btnCancelUpdateStok = document.getElementById('btnCancelUpdateStok');
        if (btnCancelUpdateStok) btnCancelUpdateStok.addEventListener('click', () => document.getElementById('modalUpdateStok').classList.remove('show'));

        const btnSubmitUpdateStok = document.getElementById('btnSubmitUpdateStok');
        if (btnSubmitUpdateStok) btnSubmitUpdateStok.addEventListener('click', submitUpdateStok);

        const searchHistory = document.getElementById('searchHistory');
        if (searchHistory) searchHistory.addEventListener('input', renderHistoryTable);
        const btnRefreshHistory = document.getElementById('btnRefreshHistory');
        if (btnRefreshHistory) btnRefreshHistory.addEventListener('click', fetchHistoryOrders);

        const histTableBody = document.getElementById('histTableBody');
        if (histTableBody) {
          histTableBody.addEventListener('click', (e) => {
            const btn = e.target.closest('[data-view-hist-id]');
            if (btn) openCodDetailModal(btn.getAttribute('data-view-hist-id')); 
          });
        }

        const btnCloseDetailHist = document.getElementById('btnCloseDetailHist');
        if (btnCloseDetailHist) btnCloseDetailHist.addEventListener('click', () => document.getElementById('modalDetailHistori').classList.remove('show'));

        const btnCancelConfirmPayment = document.getElementById('btnCancelConfirmPayment');
        if(btnCancelConfirmPayment) btnCancelConfirmPayment.addEventListener('click', () => document.getElementById('modalConfirmPayment').classList.remove('show'));
        
        const btnExecuteConfirmPayment = document.getElementById('btnExecuteConfirmPayment');
        if(btnExecuteConfirmPayment) btnExecuteConfirmPayment.addEventListener('click', executeConfirmPayment);

        const navLogout = document.getElementById('navLogout');
        if (navLogout) navLogout.addEventListener('click', () => document.getElementById('modalConfirmLogout').classList.add('show'));
        const btnCancelLogout = document.getElementById('btnCancelLogout');
        if (btnCancelLogout) btnCancelLogout.addEventListener('click', () => document.getElementById('modalConfirmLogout').classList.remove('show'));
        const btnExecuteLogout = document.getElementById('btnExecuteLogout');
        if (btnExecuteLogout) btnExecuteLogout.addEventListener('click', () => {
          localStorage.removeItem('admin_session');
          window.location.replace('/login?from=admin');
        });
      });
    </script>
  </body>
</html>