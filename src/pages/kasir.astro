---
export const prerender = false;
import POSApp from '@components/pos/POSApp';

const title = 'Kasir LaSayurku';
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <style is:global>
      :root {
        --bg: #f8fafc;
        --card: #ffffff;
        --border: #e2e8f0;
        --fg: #0f172a;
        --muted: #64748b;
        --accent: #16803d;
        --accent-strong: #14532d;
        --accent-soft: rgba(22, 128, 61, 0.08);
        --danger: #e11d48;
        --danger-soft: rgba(225, 29, 72, 0.08);
        --warn: #d97706;
        --shadow: 0 4px 20px rgba(15, 23, 42, 0.05);
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'DM Sans', sans-serif;
        background: var(--bg);
        color: var(--fg);
        min-height: 100vh;
      }
      h1, h2, h3, h4, h5 { font-family: 'Space Grotesk', sans-serif; }
      button, input, select { font: inherit; }

      .sidebar {
        position: fixed; left: 0; top: 0; bottom: 0; width: 84px; background: #ffffff;
        border-right: 1.5px solid var(--border);
        display: flex; flex-direction: column; align-items: center; padding: 20px 0 18px; z-index: 50;
      }
      .logo {
        width: 46px; height: 46px; background: linear-gradient(135deg, #16803d, #14532d);
        border-radius: 15px; display: flex; align-items: center; justify-content: center; font-weight: 800; color: white;
        margin-bottom: 26px; box-shadow: 0 10px 20px rgba(22,128,61,0.25);
      }
      .nav-group { display: flex; flex-direction: column; align-items: center; gap: 8px; width: 100%; }
      .nav-item {
        width: 52px; height: 52px; border-radius: 16px; display: flex; align-items: center; justify-content: center;
        color: var(--muted); cursor: pointer; transition: all 0.2s ease; font-size: 18px;
        border: 1px solid transparent; background: transparent;
      }
      .nav-item.active {
        background: var(--accent-soft); color: var(--accent); border-color: rgba(22, 128, 61, 0.2);
      }
      .nav-item.nav-cod.active { background: rgba(245,158,11,0.12); color: #b45309; }
      .nav-spacer { flex: 1; }

      .main { margin-left: 84px; padding: 24px 28px 32px; min-height: 100vh; }
      .page { display: none; }
      .page.active { display: block; }

      .input, select.input {
        background: #f1f5f9 !important; border: 1px solid transparent !important; border-radius: 999px; padding: 12px 20px; color: var(--fg); font-size: 14px; width: 100%; outline: none; transition: all 0.2s ease;
      }
      .input:focus { background: #ffffff !important; border-color: var(--accent) !important; box-shadow: 0 0 0 3px rgba(22,128,61,0.1); }
      select.input { appearance: none; cursor: pointer; }

      .btn {
        border: none; border-radius: 12px; font-weight: 700; cursor: pointer; transition: all 0.2s ease;
        display: inline-flex; align-items: center; justify-content: center; gap: 6px;
      }
      .btn:hover { transform: translateY(-1px); }
      .btn-primary {
        background: var(--accent);
        color: white; box-shadow: 0 4px 12px rgba(22, 128, 61, 0.2);
      }
      .btn-danger { background: var(--danger-soft); color: var(--danger); border: 1px solid rgba(225,29,72,0.2); }

      .toast-container { position: fixed; top: 24px; right: 24px; z-index: 200; display: flex; flex-direction: column; gap: 10px; }
      .toast { background: rgba(255,255,255,0.95); border: 1px solid var(--border); border-radius: 14px; padding: 12px 16px; display: flex; align-items: center; gap: 10px; font-size: 14px; box-shadow: var(--shadow); }
      .modal-overlay { position: fixed; inset: 0; background: rgba(15,23,42,0.4); backdrop-filter: blur(4px); z-index: 100; display: none; align-items: center; justify-content: center; }
      .modal-overlay.show { display: flex; }
      .modal { background: #ffffff; border: 1px solid #e2e8f0; border-radius: 24px; padding: 28px; width: min(92vw, 480px); box-shadow: 0 20px 50px rgba(0,0,0,0.15); }

      .page-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 20px; }
      .page-header h1 { font-size: clamp(1.6rem, 2vw, 2.2rem); font-weight: 800; margin: 0; color: var(--fg); }
      .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px; margin-bottom: 20px; }
      .stat-card { background: #ffffff !important; border: 1px solid #e2e8f0 !important; border-radius: 18px; padding: 18px; box-shadow: var(--shadow); }
      .stat-label { font-size: 10px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 700; }
      .stat-value { font-size: clamp(1.4rem, 2vw, 2rem); font-weight: 800; margin-top: 4px; }
      .muted { color: var(--muted); }

      /* TABS & FILTERS */
      .tab-filter-bar {
        display: flex; gap: 6px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 999px; padding: 4px; flex-wrap: wrap;
      }
      .tab-btn {
        border: none; border-radius: 999px; padding: 8px 16px; font-size: 13px; font-weight: 600; color: var(--muted); background: transparent; cursor: pointer; transition: all 0.2s ease;
      }
      .tab-btn:hover { color: var(--fg); }
      .tab-btn.active { background: var(--accent); color: white; box-shadow: 0 2px 6px rgba(22,128,61,0.2); }

      /* ORDER CARD LIST */
      .order-list { display: flex; flex-direction: column; gap: 16px; }
      .order-card {
        background: #ffffff; border: 1px solid #e2e8f0; border-radius: 20px; padding: 20px; display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; transition: box-shadow 0.2s ease;
      }
      .order-card:hover { box-shadow: 0 8px 24px rgba(15,23,42,0.06); }
      .order-info { flex: 1; min-width: 0; }
      .order-meta { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
      .order-id { font-size: 12px; font-weight: 800; color: var(--muted); letter-spacing: 0.05em; }
      .order-customer { font-size: 16px; font-weight: 800; color: var(--fg); margin-bottom: 6px; }
      .order-address { font-size: 13px; color: var(--muted); display: flex; align-items: center; gap: 6px; }
      .order-actions { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
      .status-badge { padding: 6px 12px; border-radius: 999px; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; }
      .status-pending { background: #fef3c7; color: #d97706; }
      .status-processing { background: #dbeafe; color: #2563eb; }
      .status-completed { background: #dcfce7; color: #16803d; }
      .status-cancelled { background: #fee2e2; color: #dc2626; }

      /* OVERLAY UNLOCK PIN */
      .unlock-overlay {
        position: fixed; inset: 0; z-index: 9999;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(8px);
        display: flex; align-items: center; justify-content: center;
      }
      .unlock-overlay.hidden { display: none; }
      .unlock-box {
        background: #ffffff; border: 1px solid #e2e8f0; border-radius: 24px;
        padding: 40px; width: min(90vw, 360px); box-shadow: 0 20px 50px rgba(0,0,0,0.1); text-align: center;
      }
      .pin-dot {
        width: 16px; height: 16px; border-radius: 50%;
        border: 2px solid var(--accent); transition: background 0.2s;
      }
      .pin-dot.filled { background: var(--accent); }

      @media (max-width: 860px) {
        .stok-layout-container { flex-direction: column !important; }
        .subcat-sidebar { width: 100% !important; }
        .sidebar { position: sticky; top: 0; width: 100%; height: auto; border-right: none; border-bottom: 1.5px solid #cbd5e1; padding: 12px 14px; flex-direction: row; justify-content: space-between; }
        .logo { margin: 0; }
        .nav-group { flex-direction: row; gap: 10px; }
        .nav-spacer { display: none; }
        .main { margin-left: 0; padding: 18px 14px 26px; }
        .order-card { flex-direction: column; }
        .order-actions { width: 100%; flex-direction: row; justify-content: space-between; align-items: center; }
      }
    </style>
  </head>
  <body>
    <div class="toast-container" id="toastContainer"></div>

    <!-- OVERLAY PIN LOCK -->
    <div class="unlock-overlay hidden" id="pinLockOverlay">
      <div class="unlock-box">
        <div style="width: 60px; height: 60px; border-radius: 20px; background: var(--accent-soft); color: var(--accent); display: flex; align-items: center; justify-content: center; font-size: 26px; margin: 0 auto 16px;">
          <i class="fas fa-lock"></i>
        </div>
        <h3 style="font-size: 20px; font-weight: 800; margin-bottom: 8px;">Kasir Terkunci</h3>
        <p style="color: var(--muted); font-size: 14px; margin-bottom: 24px;">Masukkan 4 digit PIN untuk membuka kasir.</p>
        
        <div id="pinError" class="hidden mb-4 rounded-lg bg-red-50 p-3 text-sm text-red-600 border border-red-200"></div>

        <!-- Tampilan 4 Titik PIN -->
        <div class="flex justify-center gap-4 mb-8" id="pinDots">
          <div class="pin-dot"></div>
          <div class="pin-dot"></div>
          <div class="pin-dot"></div>
          <div class="pin-dot"></div>
        </div>

        <!-- Keypad Angka -->
        <div class="grid grid-cols-3 gap-3">
          <button class="btn pin-key" style="background: #f1f5f9; font-size: 20px; height: 50px; border-radius: 12px;" data-key="1">1</button>
          <button class="btn pin-key" style="background: #f1f5f9; font-size: 20px; height: 50px; border-radius: 12px;" data-key="2">2</button>
          <button class="btn pin-key" style="background: #f1f5f9; font-size: 20px; height: 50px; border-radius: 12px;" data-key="3">3</button>
          <button class="btn pin-key" style="background: #f1f5f9; font-size: 20px; height: 50px; border-radius: 12px;" data-key="4">4</button>
          <button class="btn pin-key" style="background: #f1f5f9; font-size: 20px; height: 50px; border-radius: 12px;" data-key="5">5</button>
          <button class="btn pin-key" style="background: #f1f5f9; font-size: 20px; height: 50px; border-radius: 12px;" data-key="6">6</button>
          <button class="btn pin-key" style="background: #f1f5f9; font-size: 20px; height: 50px; border-radius: 12px;" data-key="7">7</button>
          <button class="btn pin-key" style="background: #f1f5f9; font-size: 20px; height: 50px; border-radius: 12px;" data-key="8">8</button>
          <button class="btn pin-key" style="background: #f1f5f9; font-size: 20px; height: 50px; border-radius: 12px;" data-key="9">9</button>
          <button class="btn" style="background: transparent; font-size: 20px; height: 50px; border-radius: 12px;"></button>
          <button class="btn pin-key" style="background: #f1f5f9; font-size: 20px; height: 50px; border-radius: 12px;" data-key="0">0</button>
          <button class="btn pin-action" style="background: #fee2e2; color: #dc2626; font-size: 16px; height: 50px; border-radius: 12px;" data-action="del"><i class="fas fa-delete-left"></i></button>
        </div>
      </div>
    </div>

    <nav class="sidebar" aria-label="Menu utama">
      <div class="logo">K</div>
      <div class="nav-group">
        <div class="nav-item active" data-page="kasir" title="Kasir Offline"><i class="fas fa-cash-register"></i></div>
        <div class="nav-item" data-page="stok" title="Stok"><i class="fas fa-warehouse"></i></div>
        <div class="nav-item" data-page="histori" title="Histori Penjualan"><i class="fas fa-clock-rotate-left"></i></div>
        <div class="nav-item nav-cod" data-page="cod" title="Orderan COD"><i class="fas fa-motorcycle"></i></div>
      </div>
      <div class="nav-spacer"></div>
      <div class="nav-item" id="navLogout" title="Keluar"><i class="fas fa-right-from-bracket" style="color: var(--danger);"></i></div>
    </nav>

    <main class="main">
      <section class="page active" id="pageKasir">
        <div id="kasir-offline-root" class="min-h-screen bg-slate-50 text-slate-900 rounded-2xl overflow-hidden p-2">
          <POSApp client:only="react" />
        </div>
      </section>

      <section class="page" id="pageStok">
        <div class="page-header">
          <div>
            <h1>Manajemen Stok</h1>
            <p class="muted" style="margin-top:4px;">Sinkronisasi otomatis dari server WooCommerce.</p>
          </div>
          <button id="btnOpenUpdateStokModal" class="btn btn-primary" style="padding:10px 18px;">
            <i class="fas fa-boxes" style="margin-right:6px;"></i> Update Stok
          </button>
        </div>

        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-label">Produk Aktif</div>
            <div class="stat-value" id="stokStatTotal">0</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Stok Rendah (&le;5)</div>
            <div class="stat-value" id="stokStatLow" style="color:var(--warn);">0</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Stok Habis</div>
            <div class="stat-value" id="stokStatOut" style="color:var(--danger);">0</div>
          </div>
        </div>

        <div class="stok-layout-container" style="display: flex; gap: 24px; align-items: flex-start;">
          <aside class="subcat-sidebar" style="width: 220px; flex-shrink: 0; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 20px; padding: 18px 14px; box-shadow: var(--shadow);">
            <div style="font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); margin-bottom: 2px;">Sub Kategori</div>
            <div id="subcatTitleMain" style="font-size: 16px; font-weight: 800; color: var(--fg); margin-bottom: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">Semua Produk</div>
            <div id="subcatList" style="display: flex; flex-direction: column; gap: 4px;"></div>
          </aside>

          <div style="flex: 1; min-width: 0;">
            <div style="display: flex; gap: 12px; margin-bottom: 20px; align-items: center; flex-wrap: wrap;">
              <div style="position: relative; flex: 1; min-width: 240px;">
                <i class="fas fa-search" style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--muted);"></i>
                <input type="text" class="input" id="searchStok" placeholder="Cari sayur, buah, atau bahan dapur..." style="padding-left: 44px;" />
              </div>
              <div style="display: flex; gap: 6px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 999px; padding: 4px;">
                <button class="stok-filter-btn active" data-stok-filter="all" style="border:none; border-radius:999px; padding:6px 14px; font-size:12px;">Semua</button>
                <button class="stok-filter-btn" data-stok-filter="low" style="border:none; border-radius:999px; padding:6px 14px; font-size:12px;">Stok Rendah</button>
                <button class="stok-filter-btn" data-stok-filter="out" style="border:none; border-radius:999px; padding:6px 14px; font-size:12px;">Stok Habis</button>
              </div>
            </div>

            <div id="stokGridView" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 16px; margin-bottom: 20px;"></div>

            <div id="stokTableView" style="display: none; background: #fff; border: 1px solid #e2e8f0; border-radius: 20px; overflow: hidden;">
              <div style="overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 14px;">
                  <thead>
                    <tr style="background: #f8fafc; border-bottom: 1px solid #e2e8f0; color: var(--muted); font-size: 12px; text-transform: uppercase;">
                      <th style="padding: 14px 18px;">Produk</th>
                      <th style="padding: 14px 18px;">Kategori</th>
                      <th style="padding: 14px 18px;">Harga</th>
                      <th style="padding: 14px 18px; text-align: center;">Jumlah Stok</th>
                      <th style="padding: 14px 18px; text-align: center;">Status</th>
                      <th style="padding: 14px 18px; text-align: center;">Aksi</th>
                    </tr>
                  </thead>
                  <tbody id="stokTableBody">
                    <tr><td colspan="6" style="text-align: center; padding: 40px; color: var(--muted);">Memuat inventaris produk...</td></tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="page" id="pageHistori">
        <div class="page-header">
          <div>
            <h1>Histori Penjualan</h1>
            <p class="muted" style="margin-top:6px;">Riwayat seluruh transaksi.</p>
          </div>
          <button id="btnRefreshHistory" class="btn btn-primary" style="padding:10px 16px;">
            <i class="fas fa-sync-alt" style="margin-right:6px;"></i> Refresh
          </button>
        </div>

        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-label">Total Transaksi</div>
            <div class="stat-value" id="histStatTotal">0</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Total Item Terjual</div>
            <div class="stat-value" id="histStatItems">0</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Rata - rata per Transaksi</div>
            <div class="stat-value" id="histStatRata" style="color:var(--accent);">Rp 0</div>
          </div>
        </div>

        <div class="card" style="padding:0; overflow:hidden; background:#fff; border:1px solid #e2e8f0; border-radius:20px;">
          <div style="padding:16px; border-bottom:1px solid #e2e8f0; display:flex; gap:12px; flex-wrap:wrap;">
            <div style="position:relative; flex:1; min-width: 200px;">
              <i class="fas fa-search" style="position:absolute; left:14px; top:50%; transform:translateY(-50%); color:var(--muted);"></i>
              <input type="text" class="input" id="searchHistory" placeholder="Cari no. transaksi atau nama produk..." style="padding-left:40px;" />
            </div>
            
            <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
              <div style="position:relative;">
                <i class="fas fa-calendar" style="position:absolute; left:14px; top:50%; transform:translateY(-50%); color:var(--muted); pointer-events:none;"></i>
                <input type="date" class="input" id="dateFromHist" style="padding-left:40px; padding-right:10px; width:170px;" />
              </div>
              <span class="muted" style="font-weight:700;">-</span>
              <div style="position:relative;">
                <i class="fas fa-calendar" style="position:absolute; left:14px; top:50%; transform:translateY(-50%); color:var(--muted); pointer-events:none;"></i>
                <input type="date" class="input" id="dateToHist" style="padding-left:40px; padding-right:10px; width:170px;" />
              </div>
            </div>
          </div>
          
          <div style="overflow-x:auto;">
            <table style="width:100%; border-collapse:collapse; text-align:left; font-size:14px;">
              <thead>
                <tr style="background:#f8fafc; border-bottom:1px solid #e2e8f0; color:var(--muted); font-size:12px; text-transform:uppercase;">
                  <th style="padding:14px 18px;">No. Order</th>
                  <th style="padding:14px 18px;">Tanggal</th>
                  <th style="padding:14px 18px;">Pelanggan</th>
                  <th style="padding:14px 18px;">Metode</th>
                  <th style="padding:14px 18px; text-align:right;">Total</th>
                  <th style="padding:14px 18px; text-align:center;">Aksi</th>
                </tr>
              </thead>
              <tbody id="histTableBody">
                <tr><td colspan="6" style="text-align:center; padding:40px; color:var(--muted);">Memuat histori transaksi...</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- PAGE COD BARU -->
      <section class="page" id="pageCod">
        <div class="page-header">
          <div>
            <h1>Orderan COD (Pesanan Web)</h1>
            <p class="muted" style="margin-top:6px;">Konfirmasi pesanan pelanggan yang masuk dari website WooCommerce.</p>
          </div>
          <button id="btnRefreshCodOrders" class="btn btn-primary" style="padding:10px 16px;">
            <i class="fas fa-sync-alt" id="iconRefreshCod" style="margin-right:6px;"></i> Refresh
          </button>
        </div>

        <!-- STATS UNTUK COD -->
        <div class="stats-grid">
          <div class="stat-card">
            <div class="stat-label">Total Orderan</div>
            <div class="stat-value" id="codStatTotal">0</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Menunggu Pembayaran</div>
            <div class="stat-value" id="codStatPending" style="color:var(--warn);">0</div>
          </div>
          <div class="stat-card">
            <div class="stat-label">Sudah Dibayar / Diproses</div>
            <div class="stat-value" id="codStatPaid" style="color:var(--accent);">0</div>
          </div>
        </div>

        <!-- TOOLBAR FILTER & SEARCH -->
        <div style="display: flex; gap: 12px; margin-bottom: 20px; align-items: center; flex-wrap: wrap;">
          <div style="position: relative; flex: 1; min-width: 240px;">
            <i class="fas fa-search" style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--muted);"></i>
            <input type="text" class="input" id="searchCod" placeholder="Cari nama pelanggan atau no order..." style="padding-left: 44px;" />
          </div>
          <div class="tab-filter-bar">
            <button class="tab-btn active" data-cod-status="all">Semua</button>
            <button class="tab-btn" data-cod-status="pending,on-hold">Menunggu Bayar</button>
            <button class="tab-btn" data-cod-status="processing">Dikirim</button>
            <button class="tab-btn" data-cod-status="completed">Selesai</button>
          </div>
        </div>

        <!-- LIST ORDER -->
        <div class="order-list" id="codOrdersList">
          <div style="text-align:center; padding:40px; color:var(--muted);">Memuat data pesanan...</div>
        </div>
      </section>
    </main>

    <!-- MODAL LOGIN ADMIN (UNTUK UPDATE STOK) -->
    <div class="modal-overlay" id="modalAdminLoginStok">
      <div class="modal" style="max-width: 380px; text-align: center;">
        <div style="width: 60px; height: 60px; border-radius: 20px; background: var(--accent-soft); color: var(--accent); display: flex; align-items: center; justify-content: center; font-size: 26px; margin: 0 auto 16px;">
          <i class="fas fa-lock"></i>
        </div>
        <h3 style="font-size: 20px; font-weight: 800; margin-bottom: 8px;">Akses Terkunci</h3>
        <p style="color: var(--muted); font-size: 14px; margin-bottom: 20px;">Masukkan kredensial Administrator untuk mengubah stok.</p>
        
        <div id="adminLoginError" class="hidden mb-4 rounded-lg bg-red-50 p-3 text-sm text-red-600 border border-red-200"></div>

        <div class="mb-4 text-left">
          <label style="font-size: 12px; font-weight: 700; color: var(--muted); display: block; margin-bottom: 6px; text-transform: uppercase;">Username</label>
          <input type="text" id="adminStokUsername" class="input" placeholder="Masukkan username admin" style="border-radius: 12px !important;" />
        </div>

        <div class="mb-6 text-left">
          <label style="font-size: 12px; font-weight: 700; color: var(--muted); display: block; margin-bottom: 6px; text-transform: uppercase;">Password</label>
          <div style="position: relative;">
            <input type="password" id="adminStokPassword" class="input" placeholder="Masukkan password" style="border-radius: 12px !important; padding-right: 40px;" />
            <button type="button" id="toggleAdminStokPass" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: var(--muted);">
              <i class="fas fa-eye"></i>
            </button>
          </div>
