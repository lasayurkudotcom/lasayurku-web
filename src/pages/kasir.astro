        <div style="display: flex; gap: 10px;">
          <button class="btn" style="flex: 1; border: 1px solid #e2e8f0; background: white; padding: 12px;" id="btnCancelAdminStok">Batal</button>
          <button class="btn btn-primary" style="flex: 1; padding: 12px;" id="btnVerifyAdminStok">Verifikasi</button>
        </div>
      </div>
    </div>

    <!-- MODAL UPDATE STOK -->
    <div class="modal-overlay" id="modalUpdateStok">
      <div class="modal" style="max-width: 420px;">
        <h3 style="font-size: 20px; font-weight: 800; margin-bottom: 20px; display:flex; align-items:center; gap:8px;">
          <i class="fas fa-boxes" style="color:var(--accent);"></i> Update Stok
        </h3>
        
        <div style="margin-bottom:16px;">
          <label style="font-size: 12px; font-weight: 700; color: var(--muted); display: block; margin-bottom: 6px; text-transform: uppercase;">Pilih Produk</label>
          <select id="updateStokProductSelect" class="input" style="border-radius:12px !important;">
            <option value="">Memuat produk...</option>
          </select>
        </div>

        <div style="display:flex; gap:12px; margin-bottom:16px;">
          <div style="flex:1;">
            <label style="font-size: 12px; font-weight: 700; color: var(--muted); display: block; margin-bottom: 6px; text-transform: uppercase;">Tipe Stok</label>
            <select id="updateStokType" class="input" style="border-radius:12px !important;">
              <option value="in">Stok Masuk (+)</option>
              <option value="out">Stok Keluar (-)</option>
            </select>
          </div>
          <div style="width:120px;">
            <label style="font-size: 12px; font-weight: 700; color: var(--muted); display: block; margin-bottom: 6px; text-transform: uppercase;">Jumlah</label>
            <input type="number" class="input" id="updateStokQty" min="1" value="0" style="font-size: 18px; font-weight: 700; text-align: center; border-radius:12px !important;" />
          </div>
        </div>

        <div style="margin-bottom:24px;">
          <label style="font-size: 12px; font-weight: 700; color: var(--muted); display: block; margin-bottom: 6px; text-transform: uppercase;">Catatan (Opsional)</label>
          <input type="text" class="input" id="updateStokNote" placeholder="Contoh: restock dari supplier" style="border-radius:12px !important;" />
        </div>

        <div style="display: flex; gap: 10px;">
          <button class="btn" style="flex: 1; border: 1px solid #e2e8f0; background: white; padding: 12px;" id="btnCancelUpdateStok">Batal</button>
          <button class="btn btn-primary" style="flex: 1; padding: 12px;" id="btnSubmitUpdateStok">Update</button>
        </div>
      </div>
    </div>

    <!-- MODAL DETAIL PESANAN / TRANSAKSI -->
    <div class="modal-overlay" id="modalDetailHistori">
      <div class="modal" style="max-width: 520px;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid #e2e8f0;">
          <h3 style="font-size:20px; font-weight:800; margin:0;" id="modalHistTitle">Detail Transaksi</h3>
          <span id="modalHistBadge" style="padding:4px 10px; border-radius:999px; font-size:11px; font-weight:800;"></span>
        </div>
        <div id="modalHistContent"></div>
        <div style="margin-top:20px; text-align:right;">
          <button class="btn" style="border:1px solid #e2e8f0; background:white; padding:10px 20px;" id="btnCloseDetailHist">Tutup</button>
        </div>
      </div>
    </div>

    <!-- MODAL REKAP SETORAN KASIR (LOGOUT) -->
    <div class="modal-overlay" id="modalConfirmLogout">
      <div class="modal" style="max-width: 480px;">
        <div class="flex justify-between items-center mb-4">
          <h3 style="font-size: 20px; font-weight: 800; margin: 0; display: flex; align-items: center; gap: 8px;">
            <i class="fas fa-cash-register" style="color: var(--accent);"></i> Tutup Kasir & Setor
          </h3>
          <button class="text-slate-400 hover:text-slate-600" id="btnCloseLogoutModal"><i class="fas fa-times"></i></button>
        </div>
        
        <div id="logoutLoader" class="text-center py-10">
          <svg class="animate-spin h-8 w-8 mx-auto text-green-600" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
          <p class="text-sm text-slate-500 mt-2">Menghitung setoran kasir hari ini...</p>
        </div>

        <div id="logoutContent" class="hidden">
          <div class="bg-slate-50 rounded-xl p-4 mb-4">
            <div class="flex justify-between mb-2">
              <span class="text-sm text-slate-500">Kasir</span>
              <span class="text-sm font-bold" id="closeKasirName">-</span>
            </div>
            <div class="flex justify-between items-center pt-2 border-t border-slate-200">
              <span class="text-base font-bold text-slate-700">Total Setoran (Tunai)</span>
              <span class="text-xl font-extrabold text-green-600" id="closeTotalCash">Rp 0</span>
            </div>
            <div class="flex justify-between mt-1">
              <span class="text-xs text-slate-400">Jumlah Transaksi: <span id="closeTrxCount">0</span></span>
            </div>
          </div>

          <div class="mb-4">
            <label class="block text-sm font-semibold text-slate-700 mb-1">Uang Fisik di Laci</label>
            <input type="number" id="closePhysicalCash" placeholder="Masukkan nominal uang fisik" class="input" style="border-radius: 12px !important; padding: 12px 16px;" />
          </div>

          <div id="closeDifference" class="hidden p-3 rounded-lg mb-4 text-center font-bold"></div>

          <div class="flex gap-2">
            <button class="btn" style="flex: 1; border: 1px solid #e2e8f0; background: white; padding: 12px;" id="btnCancelLogoutModal">Batal</button>
            <button class="btn btn-danger" style="flex: 2; padding: 12px; background: var(--danger); color: white;" id="btnExecuteLogout">
              <i class="fas fa-power-off mr-1"></i> Tutup Kasir & Logout
            </button>
          </div>
        </div>
      </div>
    </div>

    <script>
      import { getAdminSession, roleAllowed } from '../lib/adminAuth';

      document.addEventListener('DOMContentLoaded', () => {
        const session = getAdminSession('online') || getAdminSession();
        const allowed = ['kasir', 'kasir_lasayurku', 'administrator', 'admin'];
        
        const SESSION_DURATION = 12 * 60 * 60 * 1000; // 12 Jam
        const loginTimeStr = localStorage.getItem('kasir_login_time');
        
        let isSessionValid = false;

        if (session && roleAllowed(session.role, allowed)) {
          if (loginTimeStr) {
            const loginTime = parseInt(loginTimeStr, 10);
            if (Date.now() - loginTime < SESSION_DURATION) {
              isSessionValid = true;
            } else {
              localStorage.removeItem('admin_session');
              localStorage.removeItem('kasir_login_time');
            }
          } else {
            localStorage.removeItem('admin_session');
          }
        }

        if (!isSessionValid) {
          window.location.replace('/login?from=admin&error=denied');
        }
      });
    </script>

    <script is:inline>
      // KONFIGURASI PIN KASIR & AUTO-LOCK
      const KASIR_PIN = '1234'; // Ubah PIN ini sesuai keinginan Anda
      const IDLE_TIMEOUT = 3 * 60 * 1000; // 3 Menit (dalam milidetik)

      let pendingEditProductId = null;
      let products = [];
      let historyOrders = [];
      let allCodOrders = []; 
      let activeStokFilter = 'all';
      let activeMainCategory = 'all';
      let activeSubCategory = 'semua';
      let activeCodStatus = 'all';
      let isFetchingCod = false;
      let expectedCash = 0;
      
      // Variabel untuk PIN & Auto-Lock
      let currentPinInput = '';
      let idleTimer = null;

      const formatRp = (v) => `Rp ${Math.round(v || 0).toLocaleString('id-ID')}`;

      function showToast(msg, type = 'success') {
        const c = document.getElementById('toastContainer');
        if (!c) return;
        const t = document.createElement('div');
        t.className = 'toast';
        t.style.borderLeft = `4px solid ${type === 'error' ? '#dc2626' : '#16803d'}`;
        t.innerHTML = `<i class="fas ${type === 'error' ? 'fa-circle-xmark' : 'fa-check-circle'}" style="color:${type === 'error' ? '#dc2626' : '#16803d'};"></i> <span>${msg}</span>`;
        c.appendChild(t);
        setTimeout(() => t.remove(), 3000);
      }

      // ============= PIN LOCK & AUTO-LOCK LOGIC =============
      function checkPinStatus() {
        const isUnlocked = sessionStorage.getItem('pos_pin_unlocked');
        if (isUnlocked !== 'true') {
          lockScreen();
        } else {
          document.getElementById('pinLockOverlay').classList.add('hidden');
          resetIdleTimer();
        }
      }

      function lockScreen() {
        document.getElementById('pinLockOverlay').classList.remove('hidden');
        currentPinInput = '';
        updatePinDots();
        document.getElementById('pinError').classList.add('hidden');
        clearTimeout(idleTimer); // Hentikan timer saat layar terkunci
      }

      function handlePinInput(key) {
        if (currentPinInput.length < 4) {
          currentPinInput += key;
          updatePinDots();
          
          if (currentPinInput.length === 4) {
            setTimeout(verifyPin, 200); // Sedikit delay untuk animasi
          }
        }
      }

      function handlePinDelete() {
        currentPinInput = currentPinInput.slice(0, -1);
        updatePinDots();
        document.getElementById('pinError').classList.add('hidden');
      }

      function updatePinDots() {
        const dots = document.querySelectorAll('.pin-dot');
        dots.forEach((dot, index) => {
          if (index < currentPinInput.length) {
            dot.classList.add('filled');
          } else {
            dot.classList.remove('filled');
          }
        });
      }

      function verifyPin() {
        if (currentPinInput === KASIR_PIN) {
          sessionStorage.setItem('pos_pin_unlocked', 'true');
          document.getElementById('pinLockOverlay').classList.add('hidden');
          showToast('Kasir berhasil dibuka!', 'success');
          resetIdleTimer(); // Mulai hitung idle timer
        } else {
          document.getElementById('pinError').textContent = 'PIN Salah! Coba lagi.';
          document.getElementById('pinError').classList.remove('hidden');
          currentPinInput = '';
          updatePinDots();
        }
      }

      function resetIdleTimer() {
        clearTimeout(idleTimer);
        // Hanya set timer jika layar tidak dalam keadaan terkunci
        if (sessionStorage.getItem('pos_pin_unlocked') === 'true') {
          idleTimer = setTimeout(() => {
            lockScreen();
            showToast('Kasir terkunci otomatis (Idle)', 'info');
          }, IDLE_TIMEOUT);
        }
      }

      // ============= STOK FUNCTIONS =============
      function processAndRenderCategories() {
        const catMap = new Map();
        products.forEach(p => {
          if (Array.isArray(p.categories)) {
            p.categories.forEach(c => {
              const key = String(c.id || c.name || c);
              const imgUrl = c.image?.src || c.image || null;
              if (!catMap.has(key)) {
                catMap.set(key, { id: c.id || key, name: c.name || String(key), parent: c.parent || 0, image: imgUrl, count: 1 });
              } else {
                const existing = catMap.get(key);
                existing.count += 1;
                if (!existing.image && imgUrl) existing.image = imgUrl;
              }
            });
          }
        });
        renderSubcatSidebar();
      }

      function renderSubcatSidebar() {
        const listEl = document.getElementById('subcatList');
        if (!listEl) return;
        let subCats = [];
        products.forEach(p => {
          if (Array.isArray(p.categories)) {
            p.categories.forEach(c => {
              if(!subCats.find(sc => sc.id === c.id)) subCats.push(c);
            });
          }
        });

        listEl.innerHTML = `
          <button class="subcat-btn ${activeSubCategory === 'semua' ? 'active' : ''}" data-sub-cat="semua" style="display:flex; justify-content:space-between; width:100%; padding:9px 12px; border-radius:12px; font-size:13px; font-weight:600; background:transparent; border:none; cursor:pointer; color:var(--fg);">
            <span>Semua</span>
          </button>
          ${subCats.map(sc => `
            <button class="subcat-btn ${String(activeSubCategory) === String(sc.id) ? 'active' : ''}" data-sub-cat="${sc.id}" style="display:flex; justify-content:space-between; width:100%; padding:9px 12px; border-radius:12px; font-size:13px; font-weight:600; background:transparent; border:none; cursor:pointer; color:var(--fg);">
              <span>${sc.name}</span>
            </button>
          `).join('')}
        `;
        
        listEl.querySelectorAll('.subcat-btn').forEach(btn => {
          if(btn.classList.contains('active')) {
            btn.style.background = 'var(--accent)';
            btn.style.color = '#ffffff';
          }
          btn.addEventListener('click', () => {
            listEl.querySelectorAll('.subcat-btn').forEach(b => {
              b.classList.remove('active');
              b.style.background = 'transparent';
              b.style.color = 'var(--fg)';
            });
            btn.classList.add('active');
            btn.style.background = 'var(--accent)';
            btn.style.color = '#ffffff';
            activeSubCategory = btn.dataset.subCat;
            renderStokDisplay();
          });
        });
      }

      async function fetchProducts() {
        try {
          const res = await fetch('/api/adminrisman/pos/products?per_page=100');
          if (!res.ok) throw new Error('Gagal memuat data');
          const data = await res.json();
          products = Array.isArray(data) ? data : data.products || data.data || [];
          updateStokStats();
          processAndRenderCategories();
          renderStokDisplay();
          populateUpdateStokDropdown(); 
        } catch (err) {
          showToast('Gagal memuat produk dari server', 'error');
        }
      }

      function populateUpdateStokDropdown() {
        const select = document.getElementById('updateStokProductSelect');
        if (!select) return;
        select.innerHTML = products.map(p => `<option value="${p.id}">${p.name} (Stok: ${p.stock_quantity || 0})</option>`).join('');
      }

      function updateStokStats() {
        const totalEl = document.getElementById('stokStatTotal');
        if (!totalEl) return;
        totalEl.textContent = String(products.length || 0);
        let low = 0, out = 0;
        products.forEach(p => {
          const qty = Number(p.stock_quantity || 0);
          if (qty <= 0) out++;
          else if (qty <= 5) low++;
        });
        document.getElementById('stokStatLow').textContent = String(low);
        document.getElementById('stokStatOut').textContent = String(out);
      }

      function getFilteredProducts() {
        const searchInput = document.getElementById('searchStok');
        const search = (searchInput ? searchInput.value : '').toLowerCase();
        let filtered = products.filter(p => (p.name || '').toLowerCase().includes(search));

        if (activeSubCategory !== 'semua') {
          filtered = filtered.filter(p => {
            const catIds = (p.categories || []).map(c => String(c.id || c.name || c));
            return catIds.includes(String(activeSubCategory));
          });
        }

        if (activeStokFilter === 'low') {
          filtered = filtered.filter(p => Number(p.stock_quantity || 0) > 0 && Number(p.stock_quantity || 0) <= 5);
        } else if (activeStokFilter === 'out') {
          filtered = filtered.filter(p => Number(p.stock_quantity || 0) <= 0);
        }
        return filtered;
      }

      function renderStokDisplay() {
        const gridEl = document.getElementById('stokGridView');
        const tableEl = document.getElementById('stokTableView');
        if (!gridEl) return;
        gridEl.style.display = 'grid';
        if (tableEl) tableEl.style.display = 'none';

        const filtered = getFilteredProducts();
        if (!filtered.length) {
          gridEl.innerHTML = '<div style="grid-column:1/-1; text-align:center; padding:40px; color:var(--muted);">Tidak ada produk yang sesuai filter</div>';
          return;
        }

        gridEl.innerHTML = filtered.map(p => {
          const qty = Number(p.stock_quantity || 0);
          const price = Number(p.price || p.regular_price || 0);
          const image = p.images?.[0]?.src || p.image || '/placeholder-product.png';
          return `
            <div class="product-card" style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 18px; padding: 14px; transition: all 0.2s ease; display: flex; flex-direction: column; justify-content: space-between; height: 100%; box-shadow: 0 2px 8px rgba(0,0,0,0.02);">
              <div>
                <div style="width: 100%; aspect-ratio: 1 / 1; background: #ffffff; border-radius: 14px; overflow: hidden; display: flex; align-items: center; justify-content: center; margin-bottom: 12px;">
                  <img src="${image}" alt="${p.name}" style="width: 100%; height: 100%; object-fit: contain; padding: 4px;" onerror="this.src='/placeholder-product.png'" />
                </div>
                <div style="font-size: 13px; font-weight: 700; color: var(--fg); line-height: 1.35; margin-bottom: 4px;">${p.name}</div>
              </div>
              <div>
                <div style="font-size: 14px; font-weight: 800; color: var(--fg); margin-bottom: 2px;">${formatRp(price)}</div>
                <div style="font-size: 12px; font-weight: 600; color: var(--muted); margin-bottom: 10px;">Stok: <strong style="color:${qty <= 0 ? 'var(--danger)' : qty <= 5 ? 'var(--warn)' : 'var(--fg)'};">${qty}</strong></div>
                <button class="btn product-card-action-btn" data-edit-stok-id="${p.id}" style="width: 100%; padding: 8px; font-size: 12px; font-weight: 700; border: 1px solid #e2e8f0; background: #ffffff; border-radius: 10px; color: var(--fg);">
                  <i class="fas fa-edit"></i> Edit Stok
                </button>
              </div>
            </div>
          `;
        }).join('');

        gridEl.querySelectorAll('[data-edit-stok-id]').forEach(btn => {
          btn.addEventListener('click', () => openUpdateStokModal(btn.getAttribute('data-edit-stok-id')));
        });
      }

      function openUpdateStokModal(productId = null) {
        pendingEditProductId = productId;
        document.getElementById('adminStokUsername').value = '';
        document.getElementById('adminStokPassword').value = '';
        document.getElementById('adminLoginError').classList.add('hidden');
        document.getElementById('modalAdminLoginStok').classList.add('show');
      }

      async function verifyAdminStokLogin() {
        const u = document.getElementById('adminStokUsername').value;
        const p = document.getElementById('adminStokPassword').value;
        const errEl = document.getElementById('adminLoginError');
        const btnVerify = document.getElementById('btnVerifyAdminStok');
        
        btnVerify.disabled = true;
        btnVerify.textContent = 'Memverifikasi...';

        try {
          const res = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ username: u, password: p }),
          });
          const data = await res.json();

          if (res.ok || data.token || data.success) {
            const rawRole = data.user_role || data.roles || data.role || "";
            const roleStr = (Array.isArray(rawRole) ? rawRole[0] : rawRole).toString().toLowerCase().trim();
            
            if (roleStr.includes('admin') || roleStr === 'administrator') {
              document.getElementById('modalAdminLoginStok').classList.remove('show');
              
              const select = document.getElementById('updateStokProductSelect');
              if (pendingEditProductId && select) select.value = String(pendingEditProductId);
              document.getElementById('updateStokQty').value = 0;
              document.getElementById('updateStokNote').value = '';
              document.getElementById('modalUpdateStok').classList.add('show');
            } else {
              errEl.textContent = 'Akses Ditolak. Hanya Administrator yang dapat mengubah stok.';
              errEl.classList.remove('hidden');
            }
          } else {
            errEl.textContent = data.message || 'Username atau Password salah! Akses ditolak.';
            errEl.classList.remove('hidden');
          }
        } catch (err) {
          errEl.textContent = 'Terjadi kesalahan jaringan saat verifikasi.';
          errEl.classList.remove('hidden');
        } finally {
          btnVerify.disabled = false;
          btnVerify.textContent = 'Verifikasi';
        }
      }

      async function submitUpdateStok() {
        const select = document.getElementById('updateStokProductSelect');
        const productId = select.value;
        const product = products.find(p => String(p.id) === String(productId));
        if (!product) { showToast('Silakan pilih produk', 'error'); return; }

        const type = document.getElementById('updateStokType').value;
        const qty = Number(document.getElementById('updateStokQty').value);
        if (isNaN(qty) || qty <= 0) { showToast('Jumlah stok tidak valid', 'error'); return; }

        const currentStock = Number(product.stock_quantity || 0);
        let newQty = type === 'in' ? currentStock + qty : currentStock - qty;
        if (newQty < 0) newQty = 0;

        const btn = document.getElementById('btnSubmitUpdateStok');
        btn.disabled = true;
        btn.textContent = 'Menyimpan...';

        try {
          const res = await fetch('/api/adminrisman/pos/products', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: product.id, stock_quantity: newQty }),
          });
          if (!res.ok) throw new Error('Gagal mengubah stok');
          
          product.stock_quantity = newQty;
          updateStokStats();
          renderStokDisplay();
          populateUpdateStokDropdown(); 
          document.getElementById('modalUpdateStok').classList.remove('show');
          showToast(`Stok ${product.name} diperbarui menjadi ${newQty}`);
        } catch (err) {
          showToast(err.message || 'Gagal mengubah stok', 'error');
        } finally {
          btn.disabled = false;
          btn.textContent = 'Update';
        }
      }

      // ============= COD ORDERS FUNCTIONS =============
      async function fetchWebOrders() {
        if (isFetchingCod) return;
        isFetchingCod = true;
        const iconRefresh = document.getElementById('iconRefreshCod');
        if (iconRefresh) iconRefresh.classList.add('fa-spin');

        const listEl = document.getElementById('codOrdersList');
        if(listEl) listEl.innerHTML = '<div style="text-align:center; padding:40px; color:var(--muted);">Memuat data pesanan...</div>';

        try {
          const res = await fetch('/api/adminrisman/orders?status=all');
          if (!res.ok) throw new Error('Gagal memuat data');
          const data = await res.json();
          allCodOrders = data.orders || (Array.isArray(data) ? data : []);

          updateCodStats();
          renderCodOrders();
        } catch (err) {
          showToast('Gagal memuat pesanan COD', 'error');
          if(listEl) listEl.innerHTML = '<div style="text-align:center; padding:40px; color:var(--danger);">Gagal memuat data pesanan.</div>';
        } finally {
          isFetchingCod = false;
          if (iconRefresh) iconRefresh.classList.remove('fa-spin');
        }
      }

      function updateCodStats() {
        const total = allCodOrders.length;
        const pending = allCodOrders.filter(o => ['pending', 'on-hold'].includes(o.status)).length;
        const paid = allCodOrders.filter(o => ['processing', 'completed'].includes(o.status)).length;

        document.getElementById('codStatTotal').textContent = total;
        document.getElementById('codStatPending').textContent = pending;
        document.getElementById('codStatPaid').textContent = paid;
      }

      function renderCodOrders() {
        const listEl = document.getElementById('codOrdersList');
        const searchInput = document.getElementById('searchCod');
        const search = (searchInput ? searchInput.value : '').toLowerCase();

        let filtered = allCodOrders;
        if (activeCodStatus !== 'all') {
          const statusArr = activeCodStatus.split(',');
          filtered = filtered.filter(o => statusArr.includes(o.status));
        }

        filtered = filtered.filter(o => {
          const num = (o.number || `ORD-${o.id}`).toLowerCase();
          const name = (o.customer_name || 'Pelanggan').toLowerCase();
          return num.includes(search) || name.includes(search);
        });

        if (!filtered.length) {
          listEl.innerHTML = '<div style="text-align:center; padding:40px; color:var(--muted);">Tidak ada pesanan yang sesuai filter</div>';
          return;
        }

        listEl.innerHTML = filtered.map(order => {
          const address = order.shipping?.address_1 || order.billing?.address_1 || order.address || 'Alamat tidak tersedia';
          const total = Number(order.total || 0);
          
          let statusClass = 'status-pending';
          let statusText = 'Menunggu Pembayaran';
          if (order.status === 'processing') { statusClass = 'status-processing'; statusText = 'Dikirim'; }
          if (order.status === 'completed') { statusClass = 'status-completed'; statusText = 'Selesai'; }
          if (order.status === 'cancelled') { statusClass = 'status-cancelled'; statusText = 'Dibatalkan'; }

          const isPending = ['pending', 'on-hold'].includes(order.status);
          const isProcessing = order.status === 'processing';

          return `
            <div class="order-card">
              <div class="order-info">
                <div class="order-meta">
                  <span class="order-id">${order.number || `ORD-${order.id}`}</span>
                  <span style="font-size:12px; color:var(--muted);">•</span>
                  <span style="font-size:12px; color:var(--muted);">${order.date_created ? new Date(order.date_created).toLocaleString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '-'}</span>
                </div>
                <div class="order-customer">${order.customer_name || 'Pelanggan'}</div>
                <div class="order-address">
                  <i class="fas fa-map-marker-alt"></i>
                  <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width: 350px; display:inline-block; vertical-align:bottom;">${address}</span>
                </div>
              </div>
              <div class="order-actions">
                <span class="status-badge ${statusClass}">${statusText}</span>
                <div style="font-weight: 800; color: var(--fg); font-size: 16px; text-align:right;">${formatRp(total)}</div>
                <div style="display:flex; gap:8px; justify-content:flex-end;">
                  <button class="btn" style="padding:8px 12px; font-size:12px; border:1px solid #e2e8f0; background:white; color:var(--fg);" data-view-cod-id="${order.id}">
                    <i class="fas fa-eye"></i> Detail
                  </button>
                  ${isPending ? `
                    <button class="btn btn-primary" style="padding:8px 12px; font-size:12px;" data-update-status="${order.id}" data-new-status="processing">
                      <i class="fas fa-paper-plane"></i> Kirim
                    </button>
                  ` : ''}
                  ${isProcessing ? `
                    <button class="btn" style="padding:8px 12px; font-size:12px; background:#16a34a; color:white; box-shadow: 0 2px 6px rgba(22,163,74,0.2);" data-update-status="${order.id}" data-new-status="completed">
                      <i class="fas fa-money-check-dollar"></i> Bayar
                    </button>
                  ` : ''}
                </div>
              </div>
            </div>
          `;
        }).join('');

        listEl.querySelectorAll('[data-update-status]').forEach(btn => {
          btn.addEventListener('click', () => handleUpdateStatus(btn.getAttribute('data-update-status'), btn.getAttribute('data-new-status'), btn));
        });

        listEl.querySelectorAll('[data-view-cod-id]').forEach(btn => {
          btn.addEventListener('click', () => openCodDetailModal(btn.getAttribute('data-view-cod-id')));
        });
      }

      async function handleUpdateStatus(orderId, newStatus, btn) {
        const actionText = newStatus === 'processing' ? 'mengirim' : 'menyelesaikan pembayaran';
        if (!confirm(`Apakah Anda yakin ingin ${actionText} pesanan ini?`)) return;
        
        const originalText = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Proses...';
        btn.disabled = true;

        try {
          const res = await fetch('/api/adminrisman/orders', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderId, status: newStatus })
          });
          if (!res.ok) throw new Error('Gagal memproses');
          
          showToast(`Pesanan berhasil diproses!`);
          const order = allCodOrders.find(o => String(o.id) === String(orderId));
          if(order) order.status = newStatus;
          updateCodStats();
          renderCodOrders();
        } catch (err) {
          showToast('Gagal memproses pesanan', 'error');
          btn.innerHTML = originalText;
          btn.disabled = false;
        }
      }

      function openCodDetailModal(orderId) {
        const order = allCodOrders.find(o => String(o.id) === String(orderId));
        if (!order) return;

        const modal = document.getElementById('modalDetailHistori');
        const titleEl = document.getElementById('modalHistTitle');
        const badgeEl = document.getElementById('modalHistBadge');
        const contentEl = document.getElementById('modalHistContent');

        const address = order.shipping?.address_1 || order.billing?.address_1 || order.address || '-';
        const items = (order.line_items || []).map(item => `
          <div style="display:flex; justify-content:space-between; align-items:center; padding:8px 0; border-bottom:1px dashed #e2e8f0; font-size:13px;">
            <div>
              <div style="font-weight:700; color:var(--fg);">${item.name}</div>
              <div style="color:var(--muted); font-size:12px;">${formatRp(Number(item.price || 0))} x ${item.quantity}</div>
            </div>
            <div style="font-weight:700; color:var(--fg);">${formatRp(Number(item.total || (item.price * item.quantity) || 0))}</div>
          </div>
        `).join('');

        titleEl.textContent = `Order #${order.number || order.id}`;
        badgeEl.textContent = order.status ? order.status.toUpperCase() : 'PENDING';
        badgeEl.style.background = 'rgba(22,128,61,0.1)';
        badgeEl.style.color = 'var(--accent)';

        contentEl.innerHTML = `
          <div style="margin-bottom:16px;">
            <div style="display:flex; justify-content:space-between; font-size:13px; margin-bottom:6px;"><span style="color:var(--muted);">Pelanggan:</span><strong style="color:var(--fg);">${order.customer_name || 'Pelanggan'}</strong></div>
            <div style="display:flex; justify-content:space-between; font-size:13px; margin-bottom:6px;"><span style="color:var(--muted);">Telepon:</span><span style="color:var(--fg);">${order.phone || '-'}</span></div>
            <div style="display:flex; justify-content:space-between; font-size:13px; margin-bottom:6px;"><span style="color:var(--muted);">Alamat:</span><span style="color:var(--fg); text-align:right; max-width:300px;">${address}</span></div>
            <div style="display:flex; justify-content:space-between; font-size:13px; margin-bottom:6px;"><span style="color:var(--muted);">Metode Pembayaran:</span><span style="color:var(--fg); font-weight:600;">${order.payment_method_title || 'QRIS / COD'}</span></div>
          </div>
          <div style="font-size:12px; font-weight:700; color:var(--muted); text-transform:uppercase; margin-bottom:8px;">Rincian Produk</div>
          <div style="max-height:220px; overflow-y:auto; margin-bottom:16px;">${items || '<div style="color:var(--muted); font-size:13px;">Tidak ada rincian item.</div>'}</div>
          <div style="display:flex; justify-content:space-between; align-items:center; padding-top:12px; border-top:1.5px solid #e2e8f0;">
            <span style="font-weight:700; font-size:14px; color:var(--fg);">Total Transaksi</span>
            <span style="font-weight:800; font-size:18px; color:var(--accent);">${formatRp(Number(order.total || 0))}</span>
          </div>
        `;
        modal.classList.add('show');
      }

      // ============= HISTORY FUNCTIONS =============
      async function fetchHistoryOrders() {
        const tbody = document.getElementById('histTableBody');
        try {
          const res = await fetch('/api/adminrisman/orders?status=completed');
          if (!res.ok) throw new Error('Gagal memuat data');
          const data = await res.json();
          historyOrders = Array.isArray(data) ? data : (data.orders || data.data || []);
          renderHistoryTable();
        } catch (err) {
          if (tbody) tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:40px; color:var(--danger);">Gagal memuat histori transaksi</td></tr>';
        }
      }

      function renderHistoryTable() {
        const tbody = document.getElementById('histTableBody');
        if (!tbody) return;
        
        const searchInput = document.getElementById('searchHistory');
        const search = (searchInput ? searchInput.value : '').toLowerCase();
        
        const dateFromVal = document.getElementById('dateFromHist')?.value;
        const dateToVal = document.getElementById('dateToHist')?.value;
        
        let fromTime = 0;
        let toTime = Infinity;
        
        if (dateFromVal) {
          fromTime = new Date(dateFromVal).getTime();
        }
        if (dateToVal) {
          const d = new Date(dateToVal);
          d.setHours(23, 59, 59, 999);
          toTime = d.getTime();
        }

        const filtered = historyOrders.filter(o => {
          const num = (o.number || `ORD-${o.id}`).toLowerCase();
          const name = (o.customer_name || 'Pelanggan').toLowerCase();
          const matchSearch = num.includes(search) || name.includes(search);
          
          const orderTime = o.date_created ? new Date(o.date_created).getTime() : 0;
          const matchDate = orderTime >= fromTime && orderTime <= toTime;
          
          return matchSearch && matchDate;
        });

        let totalOmset = 0;
        let totalItems = 0;
        filtered.forEach(o => {
          totalOmset += Number(o.total || 0);
          if (o.line_items) {
            o.line_items.forEach(i => totalItems += Number(i.quantity || 0));
          }
        });

        document.getElementById('histStatTotal').textContent = String(filtered.length || 0);
        document.getElementById('histStatItems').textContent = String(totalItems);
        const rata = filtered.length > 0 ? (totalOmset / filtered.length) : 0;
        document.getElementById('histStatRata').textContent = formatRp(rata);

        if (!filtered.length) {
          tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; padding:40px; color:var(--muted);">Tidak ada riwayat transaksi ditemukan</td></tr>';
          return;
        }

        tbody.innerHTML = filtered.map(o => {
          const dateStr = o.date_created ? new Date(o.date_created).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' }) : '-';
          return `
            <tr style="border-bottom:1px solid rgba(15,23,42,0.05);">
              <td style="padding:14px 18px; font-weight:700;">${o.number || `ORD-${o.id}`}</td>
              <td style="padding:14px 18px; color:var(--muted); font-size:13px;">${dateStr}</td>
              <td style="padding:14px 18px; font-weight:600;">${o.customer_name || 'Pelanggan'}</td>
              <td style="padding:14px 18px;"><span style="padding:4px 8px; border-radius:6px; background:rgba(22,128,61,0.1); color:var(--accent); font-size:12px; font-weight:700;">${o.payment_method_title || 'Tunai / POS'}</span></td>
              <td style="padding:14px 18px; text-align:right; font-weight:800; color:var(--accent);">${formatRp(Number(o.total || 0))}</td>
              <td style="padding:14px 18px; text-align:center;">
                <button class="btn" style="padding:6px 12px; font-size:12px; border:1px solid #e2e8f0; background:white;" data-view-hist-id="${o.id}"><i class="fas fa-eye"></i> Detail</button>
              </td>
            </tr>
          `;
        }).join('');
      }

      // ============= TUTUP KASIR / REKAP SETORAN =============
      async function handleLogoutClick() {
        const modal = document.getElementById('modalConfirmLogout');
        const loader = document.getElementById('logoutLoader');
        const content = document.getElementById('logoutContent');
        
        modal.classList.add('show');
        loader.classList.remove('hidden');
        content.classList.add('hidden');

        try {
          const res = await fetch('/api/adminrisman/orders?status=completed');
          if (!res.ok) throw new Error('Gagal mengambil data');
          const data = await res.json();
          const orders = Array.isArray(data) ? data : (data.orders || data.data || []);

          const today = new Date().toISOString().split('T')[0];
          const cashOrders = orders.filter(o => {
            const isToday = o.date_created ? new Date(o.date_created).toISOString().split('T')[0] === today : false;
            const isCash = o.payment_method === 'pos_cash' || (o.payment_method_title && o.payment_method_title.toLowerCase().includes('tunai'));
            return isToday && isCash;
          });

          expectedCash = cashOrders.reduce((sum, o) => sum + Number(o.total || 0), 0);

          document.getElementById('closeKasirName').textContent = localStorage.getItem('admin_user_nicename') || 'Kasir';
          document.getElementById('closeTotalCash').textContent = formatRp(expectedCash);
          document.getElementById('closeTrxCount').textContent = cashOrders.length;
          document.getElementById('closePhysicalCash').value = '';
          document.getElementById('closeDifference').classList.add('hidden');

          loader.classList.add('hidden');
          content.classList.remove('hidden');
        } catch (err) {
          showToast('Gagal memuat rekap setoran', 'error');
          modal.classList.remove('show');
        }
      }

      function calculateCloseDiff() {
        const physical = Number(document.getElementById('closePhysicalCash').value) || 0;
        const diff = physical - expectedCash;
        const diffEl = document.getElementById('closeDifference');

        diffEl.classList.remove('hidden', 'bg-green-100', 'text-green-700', 'bg-red-100', 'text-red-700', 'bg-blue-100', 'text-blue-700');

        if (physical === 0) {
          diffEl.classList.add('hidden');
          return;
        }

        if (diff === 0) {
          diffEl.classList.add('bg-green-100', 'text-green-700');
          diffEl.innerHTML = `<i class="fas fa-check-circle"></i> Uang Pas! Setoran Sesuai.`;
        } else if (diff < 0) {
          diffEl.classList.add('bg-red-100', 'text-red-700');
          diffEl.innerHTML = `<i class="fas fa-exclamation-circle"></i> Uang Kurang: ${formatRp(Math.abs(diff))}`;
        } else {
          diffEl.classList.add('bg-blue-100', 'text-blue-700');
          diffEl.innerHTML = `<i class="fas fa-info-circle"></i> Uang Lebih: ${formatRp(diff)}`;
        }
      }

      // ============= INIT & EVENTS =============
      window.addEventListener('DOMContentLoaded', () => {
        // Cek status PIN saat halaman dimuat
        checkPinStatus();

        // Event Listener untuk Auto-Lock (Reset timer jika ada aktivitas mouse/keyboard)
        ['mousemove', 'keydown', 'click'].forEach(eventName => {
          document.addEventListener(eventName, () => {
            if (sessionStorage.getItem('pos_pin_unlocked') === 'true') {
              resetIdleTimer();
            }
          });
        });

        // Event Listener untuk Keypad PIN
        document.querySelectorAll('.pin-key').forEach(btn => {
          btn.addEventListener('click', () => {
            handlePinInput(btn.dataset.key);
          });
        });

        document.querySelector('.pin-action[data-action="del"]').addEventListener('click', handlePinDelete);

        document.querySelectorAll('.nav-item[data-page]').forEach((item) => {
          item.addEventListener('click', () => {
            const pageTarget = item.dataset.page;
            document.querySelectorAll('.nav-item').forEach((n) => n.classList.remove('active'));
            document.querySelectorAll('.page').forEach((p) => p.classList.remove('active'));
            item.classList.add('active');
            const targetId = pageTarget === 'cod' ? 'pageCod' : `page${pageTarget.charAt(0).toUpperCase() + pageTarget.slice(1)}`;
            const el = document.getElementById(targetId);
            if (el) el.classList.add('active');
            if (pageTarget === 'stok') fetchProducts();
            if (pageTarget === 'cod') fetchWebOrders();
            if (pageTarget === 'histori') fetchHistoryOrders();
          });
        });

        document.querySelectorAll('.tab-btn[data-cod-status]').forEach(btn => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            activeCodStatus = btn.dataset.codStatus;
            renderCodOrders();
          });
        });

        const searchCod = document.getElementById('searchCod');
        if (searchCod) searchCod.addEventListener('input', renderCodOrders);

        const btnRefreshCodOrders = document.getElementById('btnRefreshCodOrders');
        if (btnRefreshCodOrders) btnRefreshCodOrders.addEventListener('click', fetchWebOrders);

        const searchStok = document.getElementById('searchStok');
        if (searchStok) searchStok.addEventListener('input', renderStokDisplay);
        
        document.querySelectorAll('.stok-filter-btn').forEach(btn => {
          btn.addEventListener('click', () => {
            document.querySelectorAll('.stok-filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            activeStokFilter = btn.dataset.stokFilter;
            renderStokDisplay();
          });
        });

        const btnOpenUpdateStokModal = document.getElementById('btnOpenUpdateStokModal');
        if (btnOpenUpdateStokModal) btnOpenUpdateStokModal.addEventListener('click', () => openUpdateStokModal());

        const btnCancelUpdateStok = document.getElementById('btnCancelUpdateStok');
        if (btnCancelUpdateStok) btnCancelUpdateStok.addEventListener('click', () => document.getElementById('modalUpdateStok').classList.remove('show'));

        const btnSubmitUpdateStok = document.getElementById('btnSubmitUpdateStok');
        if (btnSubmitUpdateStok) btnSubmitUpdateStok.addEventListener('click', submitUpdateStok);

        const btnCancelAdminStok = document.getElementById('btnCancelAdminStok');
        if (btnCancelAdminStok) btnCancelAdminStok.addEventListener('click', () => document.getElementById('modalAdminLoginStok').classList.remove('show'));

        const btnVerifyAdminStok = document.getElementById('btnVerifyAdminStok');
        if (btnVerifyAdminStok) btnVerifyAdminStok.addEventListener('click', verifyAdminStokLogin);

        const toggleAdminStokPass = document.getElementById('toggleAdminStokPass');
        if (toggleAdminStokPass) {
          toggleAdminStokPass.addEventListener('click', () => {
            const passInput = document.getElementById('adminStokPassword');
            const icon = toggleAdminStokPass.querySelector('i');
            if (passInput.type === 'password') {
              passInput.type = 'text';
              icon.classList.remove('fa-eye');
              icon.classList.add('fa-eye-slash');
            } else {
              passInput.type = 'password';
              icon.classList.remove('fa-eye-slash');
              icon.classList.add('fa-eye');
            }
          });
        }

        const searchHistory = document.getElementById('searchHistory');
        if (searchHistory) searchHistory.addEventListener('input', renderHistoryTable);
        
        const dateFromHist = document.getElementById('dateFromHist');
        if (dateFromHist) dateFromHist.addEventListener('change', renderHistoryTable);
        
        const dateToHist = document.getElementById('dateToHist');
        if (dateToHist) dateToHist.addEventListener('change', renderHistoryTable);

        const btnRefreshHistory = document.getElementById('btnRefreshHistory');
        if (btnRefreshHistory) btnRefreshHistory.addEventListener('click', fetchHistoryOrders);

        const histTableBody = document.getElementById('histTableBody');
        if (histTableBody) {
          histTableBody.addEventListener('click', (e) => {
            const btn = e.target.closest('[data-view-hist-id]');
            if (btn) openHistoryDetailModal(btn.getAttribute('data-view-hist-id'));
          });
        }

        const btnCloseDetailHist = document.getElementById('btnCloseDetailHist');
        if (btnCloseDetailHist) btnCloseDetailHist.addEventListener('click', () => document.getElementById('modalDetailHistori').classList.remove('show'));

        // EVENT LOGOUT & SETORAN KASIR
        const navLogout = document.getElementById('navLogout');
        if (navLogout) navLogout.addEventListener('click', handleLogoutClick);
        
        const btnCloseLogoutModal = document.getElementById('btnCloseLogoutModal');
        if (btnCloseLogoutModal) btnCloseLogoutModal.addEventListener('click', () => document.getElementById('modalConfirmLogout').classList.remove('show'));
        
        const btnCancelLogoutModal = document.getElementById('btnCancelLogoutModal');
        if (btnCancelLogoutModal) btnCancelLogoutModal.addEventListener('click', () => document.getElementById('modalConfirmLogout').classList.remove('show'));
        
        const closePhysicalCashInput = document.getElementById('closePhysicalCash');
        if (closePhysicalCashInput) closePhysicalCashInput.addEventListener('input', calculateCloseDiff);
        
        const btnExecuteLogout = document.getElementById('btnExecuteLogout');
        if (btnExecuteLogout) btnExecuteLogout.addEventListener('click', () => {
          localStorage.removeItem('admin_session');
          localStorage.removeItem('kasir_login_time');
          sessionStorage.removeItem('pos_pin_unlocked'); // Hapus sesi PIN saat logout
          window.location.replace('/login?from=admin');
        });
      });

      function openHistoryDetailModal(orderId) {
        const order = historyOrders.find(o => String(o.id) === String(orderId));
        if (!order) return;
        openCodDetailModal(orderId);
      }
    </script>
  </body>
</html>