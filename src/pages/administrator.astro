---
import TokoKirimLayout from '../layouts/TokoKirimLayout.astro';
---

<TokoKirimLayout title="Dasbor Admin - LaSayurku" activeModule="dashboard" allowedRoles={['administrator', 'admin']}>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <div class="stat-card green bg-white rounded-xl p-4 border border-gray-100 card-hover">
            <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-lg bg-pri-50 flex items-center justify-center"><i class="fa-solid fa-money-bill-wave text-pri-600"></i></div>
                <span class="text-xs text-gray-500 font-medium">Penjualan Hari Ini</span>
            </div>
            <p class="text-xl font-bold text-gray-900" id="stat-revenue"><span class="inline-block w-20 h-6 bg-gray-100 animate-pulse rounded"></span></p>
            <p class="text-xs text-gray-400 mt-1" id="stat-revenue-count"><span class="inline-block w-16 h-4 bg-gray-100 animate-pulse rounded"></span></p>
        </div>
        <div class="stat-card amber bg-white rounded-xl p-4 border border-gray-100 card-hover">
            <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-lg bg-amber-50 flex items-center justify-center"><i class="fa-solid fa-clock text-amber-600"></i></div>
                <span class="text-xs text-gray-500 font-medium">Menunggu Diproses</span>
            </div>
            <p class="text-xl font-bold text-gray-900" id="stat-pending"><span class="inline-block w-10 h-6 bg-gray-100 animate-pulse rounded"></span></p>
            <p class="text-xs text-gray-400 mt-1" id="stat-processing-count"><span class="inline-block w-16 h-4 bg-gray-100 animate-pulse rounded"></span></p>
        </div>
        <div class="stat-card sky bg-white rounded-xl p-4 border border-gray-100 card-hover">
            <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-lg bg-sky-50 flex items-center justify-center"><i class="fa-solid fa-box-open text-sky-600"></i></div>
                <span class="text-xs text-gray-500 font-medium">Diproses / Dikirim</span>
            </div>
            <p class="text-xl font-bold text-gray-900" id="stat-processing"><span class="inline-block w-10 h-6 bg-gray-100 animate-pulse rounded"></span></p>
            <p class="text-xs text-gray-400 mt-1">Pesanan on-going</p>
        </div>
        <div class="stat-card rose bg-white rounded-xl p-4 border border-gray-100 card-hover">
            <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-lg bg-rose-50 flex items-center justify-center"><i class="fa-solid fa-check-circle text-rose-500"></i></div>
                <span class="text-xs text-gray-500 font-medium">Selesai Hari Ini</span>
            </div>
            <p class="text-xl font-bold text-gray-900" id="stat-completed"><span class="inline-block w-10 h-6 bg-gray-100 animate-pulse rounded"></span></p>
            <p class="text-xs text-gray-400 mt-1">Berhasil terkirim</p>
        </div>
    </div>

    <!-- Error Banner -->
    <div id="error-banner" class="hidden mb-6 rounded-xl bg-red-50 border border-red-200 p-4 text-red-700 font-medium text-sm"></div>

    <div class="grid lg:grid-cols-3 gap-4 mb-6">
        <div class="bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
            <h3 class="font-bold text-sm text-gray-900 mb-4">Pembayaran Hari Ini</h3>
            <div class="space-y-3" id="payment-stats-container">
                <div class="animate-pulse flex justify-between"><div class="w-20 h-4 bg-gray-100 rounded"></div><div class="w-16 h-4 bg-gray-100 rounded"></div></div>
                <div class="animate-pulse flex justify-between"><div class="w-20 h-4 bg-gray-100 rounded"></div><div class="w-16 h-4 bg-gray-100 rounded"></div></div>
            </div>
        </div>
        <div class="lg:col-span-2 bg-white rounded-xl p-5 border border-gray-100 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <h3 class="font-bold text-sm text-gray-900">Pesanan Terbaru</h3>
                <button id="refresh-btn" class="text-xs text-pri-600 font-semibold hover:text-pri-700 transition"><i class="fa-solid fa-rotate-right mr-1" id="refresh-icon"></i>Segarkan</button>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead><tr class="text-left text-xs text-gray-400 border-b border-gray-100">
                        <th class="pb-2 font-medium">No. Pesanan</th>
                        <th class="pb-2 font-medium">Pelanggan</th>
                        <th class="pb-2 font-medium">Total</th>
                        <th class="pb-2 font-medium">Status</th>
                        <th class="pb-2 font-medium">Waktu</th>
                    </tr></thead>
                    <tbody id="orders-tbody">
                        <tr><td colspan="5" class="py-10 text-center"><i class="fa-solid fa-circle-notch fa-spin text-pri-600 text-2xl mb-2"></i><p class="text-gray-400 text-xs mt-2">Memuat data pesanan...</p></td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script is:inline>
        let isFetching = false;

        function fmtRupiah(num) {
            const n = Number(num);
            if (isNaN(n)) return 'Rp0';
            return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(n);
        }

        function fmtTime(dateStr) {
            return new Date(dateStr).toLocaleTimeString('id-ID',{hour:'2-digit',minute:'2-digit'});
        }

        function statusBadge(status) {
            const map = { 
                'pending': ['Menunggu','badge-pending'], 
                'on-hold': ['On-hold','badge-pending'], 
                'processing': ['Diproses','badge-picked'], 
                'completed': ['Selesai','badge-delivered'], 
                'cancelled': ['Dibatalkan','badge-cancelled'],
                'failed': ['Gagal','badge-cancelled'],
                'refunded': ['Dikembalikan','badge-cancelled']
            };
            const [label,cls] = map[status] || [status,'badge-pending'];
            return `<span class="badge ${cls}">${label}</span>`;
        }

        function isToday(dateStr) {
            const d = new Date(dateStr);
            const now = new Date();
            return d.toISOString().split('T')[0] === now.toISOString().split('T')[0];
        }

        async function fetchDashboardData() {
            if (isFetching) return;
            isFetching = true;
            const refreshIcon = document.getElementById('refresh-icon');
            if (refreshIcon) refreshIcon.classList.add('fa-spin');

            try {
                const res = await fetch('/api/adminrisman/orders?status=all');
                const data = await res.json();
                
                if (data.success && data.orders) {
                    let todayRevenue = 0;
                    let todayOrdersCount = 0;
                    let pendingCount = 0;
                    let processingCount = 0;
                    let completedTodayCount = 0;
                    
                    let payments = {
                        'bacs': 0, 'cod': 0, 'qris': 0, 'other': 0
                    };

                    data.orders.forEach(order => {
                        if (order.status === 'pending' || order.status === 'on-hold') pendingCount++;
                        if (order.status === 'processing') processingCount++;

                        if (isToday(order.date_created)) {
                            if (order.status === 'completed') completedTodayCount++;
                            if (order.status !== 'cancelled' && order.status !== 'failed') {
                                todayOrdersCount++;
                                const orderTotal = Number(order.total) || 0;
                                todayRevenue += orderTotal;
                                
                                const method = order.payment_method;
                                if(method === 'bacs') payments['bacs'] += orderTotal;
                                else if(method === 'cod') payments['cod'] += orderTotal;
                                else if(method && method.includes('qris')) payments['qris'] += orderTotal;
                                else payments['other'] += orderTotal;
                            }
                        }
                    });

                    document.getElementById('stat-revenue').textContent = fmtRupiah(todayRevenue);
                    document.getElementById('stat-revenue-count').textContent = `${todayOrdersCount} transaksi hari ini`;
                    document.getElementById('stat-pending').textContent = pendingCount.toString();
                    document.getElementById('stat-processing-count').textContent = `${processingCount} sedang disiapkan`;
                    document.getElementById('stat-processing').textContent = processingCount.toString();
                    document.getElementById('stat-completed').textContent = completedTodayCount.toString();

                    // Render payment stats
                    const payContainer = document.getElementById('payment-stats-container');
                    let payHtml = '';
                    if (payments['cod'] > 0) payHtml += `<div class="flex items-center justify-between"><div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-amber-400"></span><span class="text-sm text-gray-600">COD</span></div><span class="font-semibold text-sm">${fmtRupiah(payments['cod'])}</span></div>`;
                    if (payments['bacs'] > 0) payHtml += `<div class="flex items-center justify-between"><div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-sky-400"></span><span class="text-sm text-gray-600">Transfer Bank</span></div><span class="font-semibold text-sm">${fmtRupiah(payments['bacs'])}</span></div>`;
                    if (payments['qris'] > 0) payHtml += `<div class="flex items-center justify-between"><div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-violet-400"></span><span class="text-sm text-gray-600">QRIS</span></div><span class="font-semibold text-sm">${fmtRupiah(payments['qris'])}</span></div>`;
                    if (payments['other'] > 0 || (payments['cod']===0 && payments['bacs']===0 && payments['qris']===0 && todayRevenue>0)) payHtml += `<div class="flex items-center justify-between"><div class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-gray-400"></span><span class="text-sm text-gray-600">Lainnya</span></div><span class="font-semibold text-sm">${fmtRupiah(payments['other'] || todayRevenue)}</span></div>`;
                    
                    if(todayRevenue === 0) payHtml = '<p class="text-xs text-gray-400 text-center py-2">Belum ada pembayaran hari ini</p>';
                    else payHtml += `<div class="border-t border-gray-100 pt-3 flex items-center justify-between mt-4"><span class="text-sm font-bold text-gray-900">Total</span><span class="font-bold text-pri-600">${fmtRupiah(todayRevenue)}</span></div>`;
                    
                    payContainer.innerHTML = payHtml;

                    // Render Table
                    const tbody = document.getElementById('orders-tbody');
                    const recentOrders = data.orders.slice(0, 10);
                    if (recentOrders.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="5" class="py-10 text-center text-gray-400 text-xs">Belum ada pesanan</td></tr>';
                    } else {
                        tbody.innerHTML = recentOrders.map(o => `
                            <tr class="border-b border-gray-50 hover:bg-gray-50/50">
                                <td class="py-2.5 font-mono text-xs text-pri-700 font-semibold">#${o.id}</td>
                                <td class="py-2.5"><div class="text-sm font-medium text-gray-900">${o.customer_name}</div><div class="text-[10px] text-gray-400">${o.phone}</div></td>
                                <td class="py-2.5 font-semibold text-gray-900">${fmtRupiah(o.total)}</td>
                                <td class="py-2.5">${statusBadge(o.status)}</td>
                                <td class="py-2.5 text-xs text-gray-400">${fmtTime(o.date_created)}</td>
                            </tr>
                        `).join('');
                    }

                } else {
                    showError('Gagal memuat data dari server.');
                }
            } catch (err) {
                console.error(err);
                showError('Koneksi ke server gagal. Periksa jaringan Anda.');
            } finally {
                isFetching = false;
                if (refreshIcon) refreshIcon.classList.remove('fa-spin');
            }
        }

        function showError(msg) {
            const banner = document.getElementById('error-banner');
            banner.textContent = msg;
            banner.classList.remove('hidden');
        }

        document.getElementById('refresh-btn')?.addEventListener('click', fetchDashboardData);
        fetchDashboardData();
        setInterval(fetchDashboardData, 30000);
    </script>
</TokoKirimLayout>
