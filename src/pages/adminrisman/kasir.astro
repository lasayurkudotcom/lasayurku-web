---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Kasir POS — LaSayurku" activeModule="kasir" posContext="online" allowedRoles={['kasir', 'kasir_lasayurku', 'administrator', 'admin']}>
  <div class="flex h-full flex-col bg-slate-50">
    <div class="border-b border-slate-200 bg-white px-6 py-4 flex items-center justify-between">
      <div>
        <h1 class="text-xl font-bold text-slate-900">Menunggu Pembayaran (Kasir)</h1>
        <p class="text-sm text-slate-500">Konfirmasi pembayaran pesanan sebelum masuk ke bagian Packing.</p>
      </div>
      <button id="refresh-btn" class="flex items-center gap-2 rounded-lg bg-emerald-100 px-4 py-2 text-sm font-semibold text-emerald-700 hover:bg-emerald-200 transition">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        Segarkan
      </button>
    </div>

    <div class="flex-1 overflow-auto p-6">
      <div id="loading-state" class="flex flex-col items-center justify-center py-20 text-emerald-600">
        <svg class="w-10 h-10 animate-spin mb-4" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <p class="font-medium text-slate-500">Memuat pesanan...</p>
      </div>

      <div id="empty-state" class="hidden flex-col items-center justify-center py-20 text-center">
        <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center text-slate-400 mb-4">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-900">Tidak ada pesanan baru</h3>
        <p class="text-sm text-slate-500">Semua pesanan sudah dikonfirmasi pembayarannya.</p>
      </div>

      <div id="orders-grid" class="hidden grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <!-- Dimasukkan lewat JS -->
      </div>
    </div>
  </div>

  <script is:inline>
    let isFetching = false;

    async function fetchOrders() {
      if (isFetching) return;
      isFetching = true;

      const loadingEl = document.getElementById('loading-state');
      const emptyEl = document.getElementById('empty-state');
      const gridEl = document.getElementById('orders-grid');
      
      loadingEl.classList.remove('hidden');
      loadingEl.classList.add('flex');
      emptyEl.classList.add('hidden');
      emptyEl.classList.remove('flex');
      gridEl.classList.add('hidden');
      gridEl.innerHTML = '';

      try {
        // Ambil pending dan on-hold (menunggu pembayaran / transfer bank)
        const res = await fetch('/api/adminrisman/orders?status=pending,on-hold');
        const data = await res.json();

        if (data.success && data.orders.length > 0) {
          loadingEl.classList.add('hidden');
          loadingEl.classList.remove('flex');
          gridEl.classList.remove('hidden');

          data.orders.forEach(order => {
            const date = new Date(order.date_created).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' });
            
            const div = document.createElement('div');
            div.className = 'bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col justify-between';
            div.innerHTML = `
              <div>
                <div class="flex justify-between items-start mb-4">
                  <div>
                    <h3 class="font-bold text-slate-900">${order.number}</h3>
                    <p class="text-xs text-slate-500">${date}</p>
                  </div>
                  <span class="px-2.5 py-1 bg-yellow-100 text-yellow-700 text-[10px] font-bold rounded-full uppercase">
                    ${order.status}
                  </span>
                </div>
                
                <div class="mb-4 text-sm text-slate-700">
                  <div class="font-semibold mb-1">${order.customer_name}</div>
                  <div class="flex items-center gap-1.5 text-xs text-slate-500">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
                    ${order.phone}
                  </div>
                  <div class="mt-2 text-xs font-semibold text-emerald-600">${order.payment_method_title}</div>
                </div>

                <div class="border-t border-slate-100 pt-3 mb-4">
                  <div class="text-xs text-slate-500 mb-2">Daftar Belanja:</div>
                  <ul class="text-sm space-y-1 text-slate-700">
                    ${order.line_items.map(item => `<li>• ${item.name} <span class="text-slate-400 font-medium">x${item.quantity}</span></li>`).join('')}
                  </ul>
                </div>
              </div>
              
              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <div class="font-bold text-slate-900 text-lg">Rp ${Number(order.total).toLocaleString('id-ID')}</div>
                <button data-confirm="${order.id}" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-xl text-sm font-semibold transition shadow-md shadow-emerald-600/20 active:scale-95">
                  Konfirmasi
                </button>
              </div>
            `;
            gridEl.appendChild(div);
          });
        } else {
          loadingEl.classList.add('hidden');
          loadingEl.classList.remove('flex');
          emptyEl.classList.remove('hidden');
          emptyEl.classList.add('flex');
        }
      } catch (err) {
        console.error('Fetch error:', err);
        loadingEl.innerHTML = `<p class="text-red-500">Gagal mengambil data.</p>`;
      } finally {
        isFetching = false;
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      fetchOrders();
      
      document.getElementById('refresh-btn')?.addEventListener('click', fetchOrders);

      document.getElementById('orders-grid')?.addEventListener('click', async (e) => {
        const btn = e.target.closest('button[data-confirm]');
        if (!btn) return;
        
        const orderId = btn.getAttribute('data-confirm');
        if (!confirm('Apakah pembayaran pesanan ini sudah masuk dan valid?')) return;
        
        const originalText = btn.textContent;
        btn.textContent = 'Proses...';
        btn.disabled = true;

        try {
          const res = await fetch('/api/adminrisman/orders', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderId, status: 'processing' })
          });
          
          if (res.ok) {
            fetchOrders();
          } else {
            alert('Gagal mengkonfirmasi pesanan');
            btn.textContent = originalText;
            btn.disabled = false;
          }
        } catch (err) {
          alert('Terjadi kesalahan jaringan');
          btn.textContent = originalText;
          btn.disabled = false;
        }
      });
    });
  </script>
</AdminLayout>
